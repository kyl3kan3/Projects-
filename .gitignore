# Shared build toolchain, per-app node_modules assembled by tools/build-all.sh,
# and its logs. See tools/link-deps.mjs for what lives in here and why.
.buildkit/

# Each app folder ships its own .gitignore (SCAFFOLD_GUIDE.md rule 2); these
# catch build output across all of them, including the nested web/server
# projects that three of the mobile apps carry.
node_modules/
.next/
.expo/
apps/**/out/
apps/**/dist/
apps/**/next-env.d.ts
apps/**/tsconfig.tsbuildinfo
apps/**/src-tauri/target/
__pycache__/
*.py[cod]

# Pidfiles from the dev servers build agents start while verifying. The brief
# tells them to write one rather than hunt PIDs by pattern, since pkill has
# taken out other agents' servers; the file itself is never worth committing.
.server.pid

.DS_Store
*.log
