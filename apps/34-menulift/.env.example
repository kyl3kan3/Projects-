# ------------------------------------------------------------------
# MenuLift environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Only the first four are required to run the app. Everything else turns a
# feature on: without Stripe the trial never converts, without R2 photos are
# stored in Postgres, and without Replicate the enhancement pass is a local
# relight instead of a model call. Each of those is stated in-app on the
# settings screen rather than failing quietly.
# ------------------------------------------------------------------

# --- required ---

# Postgres. Neon: console.neon.tech -> Connection Details -> use the *pooled*
# host (the one with `-pooler` in it).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/menulift?sslmode=require

# Public origin. QR codes and printed table tents encode this, so it must be the
# real one before anything goes to a print shop.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret

# --- scheduled work ---
# Protects /api/cron/tick, which runs the nightly auto-restore of 86'd dishes.
# On Vercel this is sent automatically as `Authorization: Bearer <value>`.
# If it is unset the route refuses to run rather than defaulting to open.
CRON_SECRET=your-cron-secret

# --- Stripe (per-location subscriptions) ---
# Without these, every screen works and the plan picker says billing is not
# configured. Create one price per tier, then paste the price ids.
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_MENU=your-stripe-price-id-for-the-menu-tier
STRIPE_PRICE_KITCHEN=your-stripe-price-id-for-the-kitchen-tier
STRIPE_PRICE_MARGIN=your-stripe-price-id-for-the-margin-tier

# --- Dish photo storage (Cloudflare R2, S3-compatible) ---
# All four must be set together. If any is missing, photos are stored in the
# application database and served from /api/photos — fine for a trial, not for
# real traffic.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=menulift-photos
# Public base for the bucket's custom domain, e.g. https://photos.example.com
R2_PUBLIC_BASE=your-r2-public-base-url

# --- AI photo enhancement (Replicate) ---
# Both are needed for the model pass. Pin a model *version*, never "latest".
# Without them the pipeline still runs: a local relight, contrast and 4:3 crop,
# with no background cleanup, and the review card says exactly that.
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_RELIGHT_MODEL=owner/model-name:pinned-version-hash

# Set to "1" to force the local enhancement pass even when a Replicate token is
# present — use it on staging so previews never spend money.
DRY_RUN=1
