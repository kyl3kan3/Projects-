# ------------------------------------------------------------------
# MenuLift environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# Postgres connection string (Neon: console.neon.tech -> Connection Details).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/menulift?sslmode=require

# Public base URL (QR codes point here). Local dev: http://localhost:3000
APP_URL=http://localhost:3000

# Redis for BullMQ (enhancement + CSV import jobs). Upstash TLS URL.
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Auth.js session encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret

# --- Stripe (per-location subscriptions) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Dish photo storage + enhancement ---
# Cloudflare R2: dashboard -> R2 -> Manage API tokens
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=menulift-photos
# AI photo enhancement (relight, background clean-up) via Replicate.
# replicate.com -> Account -> API tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# --- Email (weekly menu-engineering digest) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=reports@yourdomain.com

# Set to "1" to disable outbound email and enhancement API calls in dev/staging.
DRY_RUN=1
