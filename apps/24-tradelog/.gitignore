# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts

# Build output
dist/
build/
*.tsbuildinfo

# Environment files — keep .env.example tracked
.env
.env.*
!.env.example

# Drizzle migrations ARE tracked, including drizzle/meta — `drizzle-kit migrate`
# needs the journal to know what has been applied. Only local backups are ignored.
drizzle/meta/*.bak

