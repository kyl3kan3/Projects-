# ---------------------------------------------------------------- database ---
# Neon: use the pooled connection string (the host with `-pooler` in it).
DATABASE_URL=postgres://user:password@localhost:5432/tradelog

# -------------------------------------------------------------------- auth ---
# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
AUTH_SECRET=generate-a-long-random-string

# Used in absolute URLs (Stripe return URLs, sitemap, OG metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3024

# ----------------------------------------------------------------- billing ---
# dashboard.stripe.com/apikeys — the app runs fine without these; only the
# checkout and billing-portal screens need them.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
STRIPE_PRICE_TRADER_MONTHLY=your-stripe-price-id-for-trader-monthly
STRIPE_PRICE_TRADER_YEARLY=your-stripe-price-id-for-trader-yearly
STRIPE_PRICE_PRO_MONTHLY=your-stripe-price-id-for-pro-monthly
STRIPE_PRICE_PRO_YEARLY=your-stripe-price-id-for-pro-yearly

# -------------------------------------------------- broker sync credentials ---
# Encrypts stored IBKR Flex tokens at rest (AES-256-GCM). 32 bytes of hex:
# `openssl rand -hex 32`. Leave unset to disable automatic sync entirely —
# CSV and XML import work without it.
SYNC_CREDS_ENCRYPTION_KEY=

# -------------------------------------------------------------------- cron ---
# Protects /api/cron/tick. Vercel sends it as `Authorization: Bearer …`.
# The route refuses to run when this is unset rather than defaulting to open.
CRON_SECRET=generate-another-long-random-string

# Optional: how long a tick may run before it stops and leaves the rest for the
# next one. Defaults to 50000 (50s), comfortably inside a 300s function.
CRON_TICK_BUDGET_MS=

# Optional: interval for the self-hosted `npm run worker` loop. Default 900000.
TICK_INTERVAL_MS=
