# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/tradelog
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Screenshot storage (S3/R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tradelog-media

# --- Broker sync credential encryption ---
# 32-byte hex: `openssl rand -hex 32`
SYNC_CREDS_ENCRYPTION_KEY=

# --- Email (resend.com) ---
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
