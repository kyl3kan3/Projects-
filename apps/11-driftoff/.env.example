# DriftOff environment variables
# Expo exposes EXPO_PUBLIC_* vars to the app bundle; keep true secrets out of the client.

# RevenueCat public Apple API key (safe to embed in the client)
# Get it: RevenueCat dashboard -> Project -> API keys -> "Apple App Store" public key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_xxxxxxxxxxxxxxxx

# RevenueCat public Google API key (Phase 3, Android release)
# Get it: RevenueCat dashboard -> Project -> API keys -> "Google Play Store" public key
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxxxxxxxxxxxxxxx

# Base URL of the audio CDN serving manifest.json and sound files
# Get it: Cloudflare dashboard -> R2 -> your bucket -> public bucket domain (or custom domain)
EXPO_PUBLIC_AUDIO_CDN_URL=https://audio.driftoff.app

# Sentry DSN for crash reporting (public DSN, safe in client)
# Get it: sentry.io -> Project settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# --- Build-time / CI only (never shipped in the bundle) ---

# Sentry auth token for uploading source maps during EAS builds
# Get it: sentry.io -> Settings -> Auth Tokens (project:releases scope)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx

# Cloudflare R2 credentials for the content pipeline script (scripts/build-manifest)
# Get them: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=driftoff-audio

# EAS / Expo access token for CI submits (optional locally)
# Get it: expo.dev -> Account settings -> Access tokens
EXPO_TOKEN=xxxxxxxxxxxxxxxx
