# --- Database (required) ---
# Neon: use the pooled connection string, the host with "-pooler" in it.
DATABASE_URL=postgres://user:pass@localhost:5432/launchlist

# --- Auth (required) ---
# Any long random string. Generate one per environment; never share with preview.
#   openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string
# Salt for hashing visitor IPs (fraud clustering). Falls back to AUTH_SECRET.
IP_HASH_SALT=another-long-random-string

# --- Public URLs (required) ---
# Where this app is served. Used in emails, share links and OG image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3015
# Apex domain hosted pages live under, so a list is reachable at
# {slug}.launchlist.app. Pages are always ALSO served at {APP_URL}/l/{slug},
# which is what works locally where there is no wildcard DNS.
NEXT_PUBLIC_PAGES_DOMAIN=launchlist.app

# --- Email (optional; without it nobody can confirm a signup) ---
# resend.com/api-keys. Unset, every email is written to the server log instead
# and the dashboard says so on every screen that depends on sending.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=LaunchList <hello@launchlist.app>

# --- Billing (optional; upgrade buttons are disabled without it) ---
# dashboard.stripe.com/apikeys, then create one recurring price per paid tier.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_GROWTH=your-stripe-price-id-for-growth
STRIPE_PRICE_PRO=your-stripe-price-id-for-pro

# --- Background work (required in production) ---
# Protects /api/cron/tick, which sends blasts and delivers webhooks. The route
# REFUSES to run when this is unset rather than defaulting to open. On Vercel the
# platform sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-a-long-random-string

# --- Queue (optional) ---
# Only needed if you run the standalone worker (`npm run worker`) instead of the
# cron route. The worker holds a Redis lock so the two can never race.
REDIS_URL=redis://localhost:6379
