# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/launchlist
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (resend.com/api-keys) ---
RESEND_API_KEY=
EMAIL_FROM=hello@launchlist.app

# --- Custom domains (vercel.com API for domain attach) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# --- OG image generation ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=launchlist-assets

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAGES_DOMAIN=launchlist.app
