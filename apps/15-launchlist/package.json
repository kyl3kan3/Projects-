{
  "name": "launchlist",
  "version": "0.1.0",
  "private": true,
  "description": "Waitlist + launch-page builder with viral referral mechanics",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:widget && next build",
    "build:widget": "esbuild src/widget/embed.ts --bundle --minify --format=iife --target=es2019 --outfile=public/embed.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "next lint",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "bullmq": "^5.30.0",
    "ioredis": "^5.4.0",
    "stripe": "^17.5.0",
    "resend": "^4.0.0",
    "jose": "^5.9.6",
    "dotenv": "^16.4.0",
    "zod": "^3.24.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "drizzle-kit": "^0.30.0",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0"
  }
}
