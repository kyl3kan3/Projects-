# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/lumashot

# --- Auth (magic-link email login) ---
AUTH_SECRET=change-me

# --- Payments: one-time credit packs (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Image generation (replicate.com/account/api-tokens) ---
REPLICATE_API_TOKEN=
# Model/LoRA trainer + inference model slugs
REPLICATE_TRAINER_MODEL=ostris/flux-dev-lora-trainer
REPLICATE_INFERENCE_MODEL=black-forest-labs/flux-dev-lora

# --- Upload/result storage (S3 or R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=lumashot-media

# --- Email delivery of finished headshots (resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=studio@lumashot.app

NEXT_PUBLIC_APP_URL=http://localhost:3000
