{
  "name": "mergemate",
  "version": "0.1.0",
  "private": true,
  "description": "AI code-review GitHub App: low-noise bug catching and standards enforcement",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/review/worker.ts",
    "sweep": "tsx src/feedback/sweep.ts",
    "eval": "tsx src/eval/run.ts",
    "review:dry-run": "tsx src/eval/dry-run.ts",
    "lint": "eslint src",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "probot": "^13.4.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "bullmq": "^5.30.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.6",
    "dotenv": "^16.4.0",
    "zod": "^3.24.0",
    "yaml": "^2.6.0",
    "parse-diff": "^0.11.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0"
  }
}
