# MergeMate environment configuration
# Copy to .env for local development. Never commit real values.

# ---------------------------------------------------------------------------
# GitHub App (create at: GitHub -> Settings -> Developer settings -> GitHub Apps)
# ---------------------------------------------------------------------------

# Numeric App ID, shown on the app's settings page ("App ID").
APP_ID=123456

# Private key for signing installation-token JWTs.
# Generate on the app settings page ("Generate a private key"), which downloads
# a .pem file. Paste the contents here with literal \n for newlines, or set the
# path via PRIVATE_KEY_PATH instead. Keep .pem files out of git (see .gitignore).
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PRIVATE_KEY_PATH=./mergemate-dev.private-key.pem

# Webhook secret. You choose this value on the app settings page ("Webhook secret");
# Probot uses it to verify event signatures. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# OAuth credentials for dashboard "Sign in with GitHub".
# Same app settings page, "Client ID" and "Generate a new client secret".
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local webhook tunnel for development (create a channel at https://smee.io/new).
# Not used in production, where GitHub delivers directly to the public URL.
WEBHOOK_PROXY_URL=https://smee.io/your-channel

# ---------------------------------------------------------------------------
# Anthropic / Claude (get a key at https://console.anthropic.com -> API Keys)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used for the review analysis pass. Kept in config so upgrades are a
# deploy-time change, not a code change. Check current model names in the
# Anthropic docs before changing.
REVIEW_MODEL=claude-sonnet-4-5

# Cheaper model for the confidence-scoring pass (Phase 3 optimization; may be
# the same as REVIEW_MODEL initially).
CONFIDENCE_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# Postgres connection string. Get from Neon (https://neon.tech) or Supabase
# (https://supabase.com) project dashboard -> connection details. Include
# ?sslmode=require for hosted providers.
DATABASE_URL=postgres://user:password@localhost:5432/mergemate

# Redis connection string for BullMQ. Get from Upstash (https://upstash.com)
# database page ("Redis connect URL"), or redis://localhost:6379 locally.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

# Primary billing is GitHub Marketplace: plan changes arrive as
# marketplace_purchase webhooks on the App webhook above (no extra secret).
# Set the plan IDs from your Marketplace listing draft
# (github.com/marketplace -> manage listing -> plans).
MARKETPLACE_PLAN_ID_TEAM=1001
MARKETPLACE_PLAN_ID_BUSINESS=1002

# Stripe fallback for orgs that cannot purchase via Marketplace.
# Keys: https://dashboard.stripe.com/apikeys
# Webhook secret: https://dashboard.stripe.com/webhooks after adding the endpoint.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID_TEAM=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_BUSINESS=price_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Sentry DSN: https://sentry.io -> project -> Settings -> Client Keys (DSN).
# Leave empty to disable Sentry locally.
SENTRY_DSN=

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------

# Public URL of the dashboard/marketing site (used in review summary footers,
# OAuth callbacks, and email links).
DASHBOARD_URL=http://localhost:3000

# Max review jobs processed concurrently per worker process. LLM latency-bound;
# raise cautiously and watch Anthropic rate limits and per-job memory.
MAX_REVIEW_CONCURRENCY=4

# Confidence threshold (0-1) below which findings are stored but never posted.
# Conservative default; Business tier can override per installation.
CONFIDENCE_POST_THRESHOLD=0.8

# Hard cap on inline comments posted per PR regardless of findings count.
MAX_COMMENTS_PER_PR=10

# Server port for the Probot webhook receiver.
PORT=3300
