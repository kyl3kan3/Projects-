# MergeMate environment configuration
# Copy to .env (or .env.local) for local development. Never commit real values.

# ---------------------------------------------------------------------------
# GitHub App (create at: GitHub -> Settings -> Developer settings -> GitHub Apps)
#
# Permissions: pull requests read/write, contents read, checks write,
#              members read. Events: pull_request, push, installation,
#              installation_repositories, pull_request_review_comment,
#              pull_request_review_thread, marketplace_purchase.
# ---------------------------------------------------------------------------

# Numeric App ID, shown on the app's settings page ("App ID").
APP_ID=123456

# Private key for signing installation-token JWTs.
# Generate on the app settings page ("Generate a private key"), which downloads
# a .pem file. Paste the contents here with literal \n for newlines, or set the
# path via PRIVATE_KEY_PATH instead. Keep .pem files out of git (see .gitignore).
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PRIVATE_KEY_PATH=./mergemate-dev.private-key.pem

# Webhook secret. You choose this value on the app settings page ("Webhook secret");
# Probot uses it to verify event signatures. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret

# Local webhook tunnel for development (create a channel at https://smee.io/new).
# Not used in production, where GitHub delivers directly to the public URL.
WEBHOOK_PROXY_URL=https://smee.io/your-channel

# OAuth credentials for the dashboard's "Sign in with GitHub".
# Same app settings page: "Client ID" and "Generate a new client secret".
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ---------------------------------------------------------------------------
# Anthropic / Claude (get a key at https://console.anthropic.com -> API Keys)
#
# With no key set, MergeMate runs its deterministic pattern reviewer instead and
# labels every comment and dashboard row with model id "fake-deterministic". It
# never presents that output as Claude's.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=your-anthropic-api-key

# Model for the analysis pass. Kept in config so an upgrade is a deploy, not a
# code change. Current ids: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001.
REVIEW_MODEL=claude-sonnet-5

# Model for the confidence-scoring pass. May be the same, or cheaper.
CONFIDENCE_MODEL=claude-sonnet-5

# Hard ceiling on a single model call, in milliseconds.
MODEL_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# Postgres connection string. Neon (https://neon.tech) or Supabase project
# dashboard -> connection details. Use the *pooled* host and add ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/mergemate

# Redis for the BullMQ review queue. Upstash (https://upstash.com) database page
# ("Redis connect URL"), or redis://localhost:6379 locally.
#
# Leave this empty to run without a queue: the webhook handler then reviews inline,
# which is fine for a single-tenant self-host and needs no worker process.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Billing (GitHub Marketplace)
#
# Plan ids come from your Marketplace listing (github.com/marketplace -> manage
# listing -> plans). An unrecognised plan id is treated as free and logged as an
# error, so getting these wrong is loud rather than silent.
# ---------------------------------------------------------------------------

MARKETPLACE_PLAN_ID_TEAM=1001
MARKETPLACE_PLAN_ID_BUSINESS=1002

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Signs the dashboard session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=your-session-signing-secret

# Public URL of the dashboard (used in review summary footers and OAuth callbacks).
DASHBOARD_URL=http://localhost:3007

# Server port for the webhook receiver and the dashboard.
PORT=3007

# Local-only sign-in without GitHub OAuth. Refused when NODE_ENV=production.
# MERGEMATE_DEV_LOGIN=1

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------

# Bearer token for POST /internal/sweep, which polls reactions on recent review
# comments (GitHub sends no webhook for reactions). The endpoint refuses to run
# when this is unset rather than defaulting to open.
SWEEP_SECRET=your-sweep-secret

# ---------------------------------------------------------------------------
# Review tuning
# ---------------------------------------------------------------------------

# Confidence below which a finding is recorded and never posted. A repository's
# .mergemate.yml may raise this; nothing can lower it below the 0.6 product floor.
CONFIDENCE_POST_THRESHOLD=0.8

# Hard cap on inline comments per pull request, whatever the rulebook asks for.
MAX_COMMENTS_PER_PR=6

# Changed lines a single review will look at. Larger diffs are reviewed in part,
# and the summary comment says which files were skipped.
MAX_DIFF_LINES=3000

# Review jobs one worker process handles at once. LLM latency-bound; raise
# cautiously and watch Anthropic rate limits.
MAX_REVIEW_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Sentry DSN: https://sentry.io -> project -> Settings -> Client Keys (DSN).
# Leave empty to disable.
SENTRY_DSN=

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
