# ------------------------------------------------------------------
# DuesDesk environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.duesdesk.com
APP_URL=http://localhost:3000

# --- Stripe (Connect platform + our own billing) ---

# Secret API key for the PLATFORM account. Stripe Dashboard ->
# Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout and setup flows).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret for PLATFORM events (our billing).
# Local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Webhook signing secret for CONNECT (connected-account) events --
# dues payments settle on the associations' own accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-signing-secret

# Price IDs for the three DuesDesk plans (Stripe Dashboard -> Products).
STRIPE_PRICE_BLOCK=your-stripe-price-id-block
STRIPE_PRICE_NEIGHBORHOOD=your-stripe-price-id-neighborhood
STRIPE_PRICE_COMMUNITY=your-stripe-price-id-community

# --- Object storage (Cloudflare R2, S3-compatible) ---

# Issue photos, document library, generated statements.
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for Resend delivery webhooks (announcement delivery
# reports). Resend dashboard -> Webhooks.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Default From address for invoices and announcements (verified domain).
EMAIL_FROM="DuesDesk <mail@duesdesk.com>"

# --- SMS (Twilio) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number (attached to an approved 10DLC campaign for US
# traffic; STOP handling is mandatory).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider for board members).
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for member portal tokens (the no-password household links).
# Generate with: openssl rand -base64 32
PORTAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret Vercel Cron sends to /api/jobs/* routes (invoice runs,
# autopay charges, reminder ladders). Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# Set to "1" to log outbound email/SMS and skip real charges (safety
# switch for dev against imported real member data).
DRY_RUN=1
