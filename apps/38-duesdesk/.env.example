# ------------------------------------------------------------------
# DuesDesk environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Only DATABASE_URL, AUTH_SECRET and PORTAL_TOKEN_SECRET are needed to
# boot. Everything else switches a feature on: without Stripe you can
# still invoice, record checks, run the delinquency ladder and keep the
# issue log; without Resend and Twilio, sends are logged instead.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. It is used to build the payment links that
# go into members' emails, so it must be the address they can reach.
# Local dev: http://localhost:3038
APP_URL=http://localhost:3038

# Board session cookie secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for member portal links (the no-password household pages)
# and for signed file URLs. Deliberately separate from AUTH_SECRET,
# because portal links sit in inboxes for months.
# Generate with: openssl rand -base64 32
PORTAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret Vercel Cron sends to /api/cron/tick (invoice runs,
# late fees, autopay charges, reminder ladder). The job REFUSES to run
# when this is unset. Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Safety switch ---

# "1" (the default) logs every outbound email and SMS instead of sending
# it, and refuses real Stripe charges. Leave it on until you have
# rehearsed a full cycle: association rosters are real people, and a
# stray reminder run to 63 households cannot be taken back.
DRY_RUN=1

# --- Stripe: dues (Connect) and DuesDesk's own subscription ---

# Secret API key for the PLATFORM account. Stripe Dashboard ->
# Developers -> API keys. Dues are charged on each association's own
# connected account, so association money never touches our balance.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret for PLATFORM events (our own billing).
# Local dev: stripe listen --forward-to localhost:3038/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Webhook signing secret for CONNECT (connected-account) events --
# dues settle on the associations' own accounts.
# Local dev: stripe listen --forward-connect-to localhost:3038/api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-signing-secret

# Recurring price IDs for the three DuesDesk plans
# (Stripe Dashboard -> Products).
STRIPE_PRICE_BLOCK=your-stripe-price-id-block
STRIPE_PRICE_NEIGHBORHOOD=your-stripe-price-id-neighborhood
STRIPE_PRICE_COMMUNITY=your-stripe-price-id-community

# --- Object storage: issue photos and the document library ---

# Cloudflare R2 (S3 API). Set ALL FOUR to use R2; leave them blank and
# DuesDesk writes to LOCAL_STORAGE_DIR instead, serving objects from
# /api/files behind short-lived signed URLs. Both adapters expose the
# same signed-URL contract (see src/lib/storage.ts).
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# Where the local storage adapter writes when R2 is not configured.
# Relative to the app directory. Fine for development; on a serverless
# host use R2, because the filesystem there is not persistent.
LOCAL_STORAGE_DIR=.data/uploads

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for invoices, reminders and announcements. Must
# be on a domain you have verified with Resend (SPF/DKIM), or a third of
# your roster will never see a dues notice.
EMAIL_FROM="DuesDesk <mail@duesdesk.com>"

# --- SMS (Twilio) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
# The auth token also validates inbound STOP replies, and that webhook
# refuses to process anything when it is unset.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number, attached to an approved 10DLC campaign for US
# traffic. STOP handling is mandatory and is implemented at
# /api/webhooks/twilio -- point Twilio's inbound webhook there.
TWILIO_FROM_NUMBER=your-twilio-phone-number
