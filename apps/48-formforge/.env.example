# ------------------------------------------------------------------
# FormForge environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values. Several vendors below touch PHI -- execute
# their BAAs before pointing production traffic at them.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for migrations).
# Use a paid, BAA-covered Neon plan for anything touching real PHI.
# https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/formforge?sslmode=require

# Redis connection string for BullMQ (job payloads carry ids only, never
# PHI). Upstash dashboard -> your database -> "Redis Connect" (TLS URL).
# https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.formforge.health
APP_URL=http://localhost:3000

# --- Encryption ---

# Master key (base64, 32 bytes) that wraps per-practice data-encryption
# keys (envelope encryption). Generate with: openssl rand -base64 32
# Rotate via the key-rotation runbook, never by simple replacement.
FIELD_ENCRYPTION_MASTER_KEY=generate-with-openssl-rand-base64-32

# HMAC secret for hashing intake link tokens before storage.
# Generate with: openssl rand -base64 32
INTAKE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- File storage (AWS S3) ---

# IAM access key pair scoped to the uploads bucket only (least
# privilege). AWS Console -> IAM -> Users -> Security credentials.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Bucket for encrypted uploads + rendered PDFs (SSE-KMS enabled).
S3_BUCKET=formforge-uploads-dev

# --- Stripe (our billing; no PHI ever reaches Stripe) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=price_xxx
STRIPE_PRICE_GROUP=price_xxx
STRIPE_PRICE_CLINIC=price_xxx

# --- Email (Resend; messages carry name + link only, no PHI) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="FormForge <intake@mail.formforge.health>"

# --- SMS (Twilio; BAA available -- execute it before production) ---

# Account SID and Auth Token: Twilio Console "Account Info" panel.
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number attached to an approved 10DLC campaign.
TWILIO_FROM_NUMBER=+15555550123

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional staff sign-in). Google Cloud Console ->
# APIs & Services -> Credentials.
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx

# --- Observability (optional in dev) ---

# Sentry DSN (PII scrubbing must stay enabled). https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety
# switch for local dev and staging).
DRY_RUN=1
