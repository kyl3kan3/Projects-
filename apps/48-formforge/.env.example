# ------------------------------------------------------------------
# FormForge environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Four variables are required to run the product. Everything else degrades
# honestly: no Stripe means the billing screen says so, no Resend or SMS
# credentials means invites and reminders are logged instead of sent, no S3
# means uploads are stored as encrypted bytes in Postgres instead.
#
# Two of the four are load-bearing for patient data and have no fallback on
# purpose -- FIELD_ENCRYPTION_MASTER_KEY and INTAKE_TOKEN_SECRET. Losing the
# master key means losing every practice's records; a default value would
# mean anyone with the source could read them.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the pooled URL for the app and the direct URL for drizzle-kit
# migrations. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/formforge?sslmode=require

# Signing secret for the staff session cookie (12-hour expiry).
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Wraps every practice's AES-256 data encryption key. Exactly 64 hex
# characters. BACK THIS UP SOMEWHERE THE DATABASE BACKUP IS NOT -- without it,
# every encrypted field in every practice is permanently unreadable. In
# production this belongs in a KMS; the wrap/unwrap pair in lib/crypto.ts is
# the only seam that has to change.
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_MASTER_KEY=generate-with-openssl-rand-hex-32

# HMAC key for patient intake link tokens and the patient-name blind index.
# Rotating it invalidates every outstanding intake link and orphans the blind
# index, so treat it as long-lived.
# Generate with: openssl rand -base64 32
INTAKE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Public base URL. Local dev: http://localhost:3048. Production: your deployed
# domain. Patient links are built from this.
APP_URL=http://localhost:3048

# --- Scheduled work ---

# Shared secret protecting /api/cron/tick (reminder sends, link expiry,
# retention sweep). The route refuses to run when this is unset rather than
# defaulting to open.
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional: how often the long-lived worker polls, in milliseconds. Only used
# by `npm run worker`; on Vercel alone the daily cron is enough.
WORKER_INTERVAL_MS=60000

# --- Email (optional: Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
# Without it, invites and reminders are logged instead of sent.
RESEND_API_KEY=your-resend-api-key

# From address for intake links and reminders (domain verified in Resend).
# Message bodies carry a patient first name, the practice name and the link --
# nothing else. See lib/messages.ts and its test.
EMAIL_FROM="FormForge <intake@mail.formforge.health>"

# --- SMS (optional: Twilio) ---

# Account SID and auth token. https://console.twilio.com
# US traffic also needs 10DLC registration, which takes weeks.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- File storage (optional: AWS S3 with SSE-KMS) ---

# When unset, uploaded files are stored as AES-256-GCM envelopes in Postgres.
# Nothing is unprotected either way -- files are encrypted by the application
# before they reach storage.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=formforge-uploads-dev

# --- Stripe (optional: billing) ---

# Secret key. Stripe Dashboard -> Developers -> API keys. Use a test key in
# development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Dashboard -> Developers -> Webhooks, or from
# `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Monthly price IDs for the three plans (Dashboard -> Products).
STRIPE_PRICE_SOLO=your-stripe-price-id-for-solo
STRIPE_PRICE_GROUP=your-stripe-price-id-for-group
STRIPE_PRICE_CLINIC=your-stripe-price-id-for-clinic

# --- Safety ---

# Set to "1" to log outbound email and SMS instead of sending it. Leave it on
# in development and staging: a reminder ladder pointed at real addresses is an
# easy mistake to make once.
DRY_RUN=1
