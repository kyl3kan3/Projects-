{
  "name": "formforge",
  "version": "0.1.0",
  "private": true,
  "description": "HIPAA-conscious patient intake, e-signature, and audit trail for therapists and small clinics",
  "scripts": {
    "dev": "next dev -p 3048",
    "build": "next build",
    "start": "next start -p 3048",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:db": "NODE_PATH=./node_modules tsx --test src/db/*.itest.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "NODE_PATH=./node_modules tsx src/db/seed.ts",
    "worker": "NODE_PATH=./node_modules tsx src/worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "jose": "^5.9.6",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "twilio": "^5.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
