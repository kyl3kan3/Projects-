# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/cloudspend
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- AWS (our side of cross-account assume-role) ---
AWS_ACCESS_KEY_ID=            # IAM user/role permitted to sts:AssumeRole into customer roles
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Template bucket for the CloudFormation quick-create link
CFN_TEMPLATE_URL=

# --- Slack app (api.slack.com/apps) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- GitHub deploy correlation (github.com/settings/apps) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (resend.com) ---
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
