# Copy to .env.local — Next reads that automatically, and so does the worker.
# Every value here is a placeholder; never commit real keys.

# --- Database (neon.tech, or any Postgres) -------------------------------
# Use Neon's POOLED connection string (the host with `-pooler` in it).
DATABASE_URL=postgres://user:pass@localhost:5432/cloudspend

# --- Auth ----------------------------------------------------------------
# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Public URL ----------------------------------------------------------
# Used in Slack links, the CloudFormation callback and the trend image URL.
APP_URL=http://localhost:3030

# --- AWS: our side of the cross-account assume-role ---------------------
# The IAM principal allowed to sts:AssumeRole into each customer's read-only
# role. LEAVE THESE UNSET IN DEVELOPMENT: with no credential, CloudSpend runs a
# deterministic synthetic cost feed instead, and every screen fed by it is
# labelled "demo data". Nothing is ever presented as a real bill.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# The account id that appears in the CloudFormation trust policy customers read.
CLOUDSPEND_AWS_ACCOUNT_ID=your-12-digit-aws-account-id
# Where the published read-only CloudFormation template lives.
CLOUDSPEND_CFN_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/cloudspend-readonly-role.yml

# --- Slack app (api.slack.com/apps) -------------------------------------
# Without these, alerts fall back to email; without a Resend key too, they are
# written to the in-app alert log with their full text.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# --- Billing (dashboard.stripe.com/apikeys) -----------------------------
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price ids for the three flat tiers (dashboard.stripe.com/products).
STRIPE_PRICE_SOLO=your-stripe-price-id-for-solo
STRIPE_PRICE_STARTUP=your-stripe-price-id-for-startup
STRIPE_PRICE_SCALE=your-stripe-price-id-for-scale

# --- Email fallback (resend.com/api-keys) -------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CloudSpend <alerts@cloudspend.dev>

# --- The scheduled tick -------------------------------------------------
# /api/cron/tick refuses to run unless this is set; Vercel sends it as an
# Authorization bearer token. openssl rand -hex 32
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional: how long one tick may spend before it stops and resumes next time.
# CRON_TICK_BUDGET_MS=50000
# Optional: interval for the standalone worker (`npm run worker`), in ms.
# WORKER_INTERVAL_MS=900000

# --- Deploy correlation --------------------------------------------------
# Nothing to configure: each org gets its own webhook URL and signing secret,
# shown in Settings. Point a GitHub webhook or your deploy script at it.
