{
  "name": "safetydeck",
  "version": "0.1.0",
  "private": true,
  "description": "OSHA compliance kit for small construction and field companies: toolbox talks with on-phone crew sign-off, incident log with OSHA 300/300A output, and cert expiry tracking",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
