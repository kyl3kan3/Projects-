    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.775.0",
    "@aws-sdk/s3-request-presigner": "^3.775.0",
    "@react-email/components": "^0.0.36",
    "@serwist/next": "^9.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "idb": "^8.0.0",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "signature_pad": "^4.2.0",
