# ------------------------------------------------------------------
# SafetyDeck environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Crew links are built from this, so it has to be
# reachable from a phone. Local dev: http://localhost:3037.
# Production: your deployed domain, e.g. https://app.safetydeck.co
APP_URL=http://localhost:3037
NEXT_PUBLIC_APP_URL=http://localhost:3037

# --- Object storage (Cloudflare R2, S3-compatible) ---

# Huddle photos, cert-card photos, and generated PDFs. Signature strokes are NOT
# here: they are vector path data on the sign-off row, because the record is
# worthless without them.
#
# All four are optional. With them unset, the same bytes are stored in Postgres
# (`stored_objects`) and served through the same authorised route — so the whole
# product, including binder export, works on a laptop with only a database.
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- SMS (Twilio) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number (must be attached to an approved 10DLC campaign
# for US traffic -- registration takes weeks, start early).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for reminders and digests (verified domain).
EMAIL_FROM="SafetyDeck <alerts@safetydeck.co>"

# --- Stripe (our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Local dev: from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_CREW=your-stripe-price-id-crew
STRIPE_PRICE_COMPANY=your-stripe-price-id-company
STRIPE_PRICE_FLEET=your-stripe-price-id-fleet

# --- Auth (office users: scrypt + a signed JWT session cookie via jose) ---

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- App secrets ---

# Signing key for crew-link tokens (the no-login foreman links). Kept separate
# from AUTH_SECRET on purpose: a crew token travels by SMS to a phone that is not
# yours, and rotating it must not sign every office user out.
# Generate with: openssl rand -base64 32
CREW_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret Vercel Cron sends to /api/cron/tick as `Authorization: Bearer`.
# The route refuses to run when this is unset rather than defaulting to open.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: how long the daily sweep may run before it stops and leaves the rest
# for the next invocation. Defaults to 50000 (Vercel's function cap is 300s).
CRON_TICK_BUDGET_MS=

# Set to "1" to log outbound SMS/email instead of sending — a safety switch for
# development against real foreman phone numbers. It defaults to ON whenever no
# Resend or Twilio credential is configured; set it to "0" to actually send.
DRY_RUN=1
