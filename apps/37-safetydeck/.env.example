# ------------------------------------------------------------------
# SafetyDeck environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.safetydeck.co
APP_URL=http://localhost:3000

# --- Object storage (Cloudflare R2, S3-compatible) ---

# Signatures, huddle photos, cert-card photos, binder PDFs.
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- SMS (Twilio) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number (must be attached to an approved 10DLC campaign
# for US traffic -- registration takes weeks, start early).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for reminders and digests (verified domain).
EMAIL_FROM="SafetyDeck <alerts@safetydeck.co>"

# --- Stripe (our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev: from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_CREW=your-stripe-price-id-crew
STRIPE_PRICE_COMPANY=your-stripe-price-id-company
STRIPE_PRICE_FLEET=your-stripe-price-id-fleet

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider for office users).
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for crew-link tokens (the no-login foreman links).
# Generate with: openssl rand -base64 32
CREW_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret Vercel Cron sends to /api/jobs/* routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# Set to "1" to log outbound SMS/email instead of sending (safety switch
# for dev against real foreman phone numbers).
DRY_RUN=1
