# ------------------------------------------------------------------
# PermitPath environment variables
# Copy to .env.local (Next.js reads it, and so does `npm run worker`).
# Every value here is a descriptive placeholder — never commit real keys.
# ------------------------------------------------------------------

# --- Required ---

# Postgres connection string. Neon: console.neon.tech -> Connection Details.
# Use the pooled string here; the app's client sets prepare:false for PgBouncer.
DATABASE_URL=postgres://user:password@localhost:5432/permitpath

# Direct (unpooled) string for drizzle-kit migrations only. Optional locally —
# db:migrate falls back to DATABASE_URL. On Neon, use the -direct host.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.us-east-2.aws.neon.tech/permitpath

# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# Public base URL. Local dev: http://localhost:3032
APP_URL=http://localhost:3032

# --- Background sweep (crawls, expiry ladder, alert fan-out) ---

# Shared secret for /api/cron/tick. Vercel Cron sends it as a bearer token
# automatically; the route refuses to run when this is unset, because an open
# trigger crawls other people's servers and emails real contractors.
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional: how long one pass may run before it defers the rest (default 50000).
# CRON_TICK_BUDGET_MS=50000
# Optional: interval for `npm run worker` (default 60000).
# WORKER_INTERVAL_MS=60000

# --- Crawler etiquette ---

# Identify honestly and include a contact URL: we are guests on municipal servers.
CRAWLER_USER_AGENT="PermitPathBot/1.0 (+https://permitpath.com/bot)"
# Sources taken per pass. Per-host concurrency is always 1 regardless.
CRAWL_CONCURRENCY=2

# --- Billing (OPTIONAL) ---
# Without these, plan limits still apply and the billing screen says checkout is
# unavailable rather than offering a button that throws.

# dashboard.stripe.com/apikeys — use the test key in development.
STRIPE_SECRET_KEY=your-stripe-secret-key
# dashboard.stripe.com/webhooks -> your endpoint -> Signing secret. Locally:
# stripe listen --forward-to localhost:3032/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price ids (dashboard.stripe.com/products). Annual = 10x monthly.
STRIPE_PRICE_CREW_MONTHLY=your-stripe-price-id-for-crew-monthly
STRIPE_PRICE_CREW_ANNUAL=your-stripe-price-id-for-crew-annual
STRIPE_PRICE_COMPANY_MONTHLY=your-stripe-price-id-for-company-monthly
STRIPE_PRICE_COMPANY_ANNUAL=your-stripe-price-id-for-company-annual
STRIPE_PRICE_REGIONAL_MONTHLY=your-stripe-price-id-for-regional-monthly
STRIPE_PRICE_REGIONAL_ANNUAL=your-stripe-price-id-for-regional-annual

# --- Email (OPTIONAL) ---
# With no key, alert email is logged with its full body instead of sent, and the
# app never reports a logged alert as delivered.

# resend.com/api-keys — verify a sending domain first.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=PermitPath <alerts@permitpath.com>

# --- Geocoding (OPTIONAL) ---
# With no token, the new-job screen matches the place name out of the address text
# and labels the suggestion as such. Either way the office confirms the authority.
# account.mapbox.com -> Access tokens (geocoding scope)
MAPBOX_TOKEN=your-mapbox-token
