# ------------------------------------------------------------------
# PermitPath environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values. All placeholders are descriptive --
# replace them with the real value from the linked dashboard.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string (Neon: console.neon.tech -> Connection Details).
# Use the pooled connection string for the app, the direct one for
# drizzle-kit migrations.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/permitpath?sslmode=require

# Redis connection string for BullMQ (crawl scheduling, alert fan-out,
# expiry scans). Upstash dashboard -> your database -> "Redis Connect"
# (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:your-upstash-password@your-upstash-host:6379

# Public base URL. Local dev: http://localhost:3000
# Production: your deployed domain, e.g. https://app.permitpath.com
APP_URL=http://localhost:3000

# --- Stripe (subscriptions: Crew / Company / Regional) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use your test-mode key in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (Stripe.js on checkout/billing pages). Same page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret for /api/webhooks/stripe. Stripe Dashboard ->
# Developers -> Webhooks -> your endpoint -> Signing secret. For local dev,
# from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (rule-change alerts, expiry alerts, digests) ---

# Resend: resend.com -> API Keys. Verify a sending domain first.
RESEND_API_KEY=your-resend-api-key

# Default From address for alerts and digests (must be on a domain
# verified in Resend -> Domains).
EMAIL_FROM=alerts@yourdomain.com

# Signing secret for Resend delivery webhooks (bounce/complaint events
# feed the suppression list). Resend dashboard -> Webhooks -> your endpoint.
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- Geocoding (address -> jurisdiction resolution) ---

# Mapbox: account.mapbox.com -> Access tokens (geocoding scope)
MAPBOX_TOKEN=your-mapbox-token

# --- Crawler (jurisdiction-page change detection) ---

# User agent sent with every crawl. Identify honestly and include a
# contact URL -- we are polite guests on municipal servers.
CRAWLER_USER_AGENT="PermitPathBot/1.0 (+https://permitpath.com/bot)"

# Max simultaneous fetches across all sources (per-host limit is always 1
# regardless). Keep low; municipal sites are fragile.
CRAWL_CONCURRENCY=4

# --- Observability (optional in dev) ---

# Sentry DSN, used by both app and worker. Sentry -> Project ->
# Settings -> Client Keys (DSN). https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and crawl writes, logging intended
# actions instead (safety switch for local dev and staging).
DRY_RUN=1
