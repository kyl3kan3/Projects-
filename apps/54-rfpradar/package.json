{
  "name": "rfpradar",
  "version": "0.1.0",
  "private": true,
  "description": "RFP/tender discovery and response workspace for agencies and B2B services firms: SAM.gov + state portal ingestion, scored matches with reasons, deadline calendar, go/no-go scorecards, and a reusable answer library",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-sources": "tsx src/db/seed-sources.ts",
    "test": "tsx --test src/**/*.test.ts",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "bullmq": "^5.44.0",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "fast-xml-parser": "^5.2.0",
    "ics": "^3.8.1",
    "ioredis": "5.10.1",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
