# ------------------------------------------------------------------
# RFPRadar environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/rfpradar?sslmode=require

# Redis connection string for BullMQ. Upstash dashboard -> your database
# -> "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.rfpradar.io
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret (HS256 JWT in an httpOnly cookie).
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for signing ICS calendar-feed tokens (jose).
# Generate with: openssl rand -base64 32
ICS_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Ingestion ---

# SAM.gov public API key for the Opportunities API.
# Register at https://sam.gov -> Account Details -> API Key.
SAM_GOV_API_KEY=your-sam-gov-api-key

# User-Agent string sent with state-portal fetches. Be honest: name the
# product and a contact URL so portal operators can reach you.
INGEST_USER_AGENT="RFPRadarBot/1.0 (+https://rfpradar.io/bot)"

# --- Stripe (RFPRadar's own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use the test-mode key in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SCOUT=your-scout-price-id
STRIPE_PRICE_PURSUIT=your-pursuit-price-id
STRIPE_PRICE_CAPTURE=your-capture-price-id

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for scans and reminders (domain verified in
# Resend -> Domains).
EMAIL_FROM="RFPRadar <scan@mail.rfpradar.io>"

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/Slack and log instead (safety
# switch for local dev and staging).
DRY_RUN=1

# --- Scheduling ---

# Shared secret for the cron-triggered tick at /api/cron/tick, used when
# the app runs on a host with no always-on worker (Vercel + vercel.json
# crons). Sent as `Authorization: Bearer <secret>`. The route refuses to
# run when this is unset — an unprotected trigger is worse than no trigger.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32
