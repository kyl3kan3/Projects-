# --- Mobile app (Expo) ---
# RevenueCat public SDK keys (app.revenuecat.com -> project -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# API base URL (Fastify server)
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Companion web (web/) ---
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- API server + worker (src/server) ---
# Neon Postgres with pgvector enabled. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/studyreel?sslmode=require
# Upstash Redis for BullMQ (TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Transcription (console.deepgram.com -> API keys)
DEEPGRAM_API_KEY=

# Generation + verification (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
GENERATION_MODEL=claude-sonnet-5

# File storage (Cloudflare R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=studyreel-sources

# RevenueCat secret key for server-side entitlement checks
# (app.revenuecat.com -> project -> API keys -> secret)
REVENUECAT_SECRET_KEY=

# Session signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# Magic-link + .edu verification email (resend.com -> API keys)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="StudyReel <hello@mail.studyreel.app>"

# --- Observability (optional in dev) ---
SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# --- Worker ---
# Set to "1" to use fixture transcripts/generations instead of live APIs
# (cost + safety switch for local dev).
DRY_RUN=1
