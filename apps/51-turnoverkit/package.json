{
  "name": "turnoverkit",
  "version": "0.1.0",
  "private": true,
  "description": "Short-term-rental turnover operations: iCal-synced scheduling, photo-verified checklists, damage logs, and restock tracking for hosts with 2-20 units",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
