    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "bullmq": "^5.44.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "ioredis": "5.10.1",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "node-ical": "^0.18.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "twilio": "^5.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
