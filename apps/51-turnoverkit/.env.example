# ------------------------------------------------------------------
# TurnoverKit environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/turnoverkit?sslmode=require

# Redis connection string for BullMQ. Upstash dashboard -> your database
# -> "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.turnoverkit.com
APP_URL=http://localhost:3000

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# HMAC secret for signing cleaner job tokens (jose).
# Generate with: openssl rand -base64 32
JOB_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (TurnoverKit's own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use the test-mode key in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=your-solo-price-id
STRIPE_PRICE_HOST=your-host-price-id
STRIPE_PRICE_OPERATOR=your-operator-price-id

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for job notifications and digests (domain
# verified in Resend -> Domains).
EMAIL_FROM="TurnoverKit <alerts@mail.turnoverkit.com>"

# --- SMS (Twilio) ---

# Account SID and auth token. Twilio Console -> Account Info.
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# The Twilio phone number cleaner SMS is sent from (E.164 format).
TWILIO_FROM_NUMBER=+15555550100

# --- Object storage (Cloudflare R2, S3 API) ---

# Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=turnoverkit-photos

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety
# switch for local dev and staging -- never text a real cleaner from dev).
DRY_RUN=1
