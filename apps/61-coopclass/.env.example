# ------------------------------------------------------------------
# CoopClass environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string (Neon; pooled for app, direct for migrations).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/coopclass?sslmode=require

# Redis connection string for BullMQ (Upstash TLS rediss:// URL).
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL. Local dev: http://localhost:3000.
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for waitlist claim links (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (Connect for co-op family fees; Billing for CoopClass) ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# Price IDs (Stripe Dashboard -> Products).
STRIPE_PRICE_GATHERING=your-gathering-price-id
STRIPE_PRICE_COMMUNITY=your-community-price-id
STRIPE_PRICE_ACADEMY=your-academy-price-id
STRIPE_PRICE_SUMMER_PAUSE=your-summer-pause-price-id

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="CoopClass <hello@mail.coopclass.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and Stripe calls and log instead.
DRY_RUN=1
