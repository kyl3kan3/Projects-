# --- Mobile app (Expo) ---
# RevenueCat public SDK keys (app.revenuecat.com -> Project settings -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Companion API base URL
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Companion server (src/server) ---
# Google OAuth for Gmail read-only receipt scanning (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Claude API for receipt/price-hike classification (console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Postgres for server-side account/link storage
DATABASE_URL=postgres://user:pass@localhost:5432/subsage
# Push notifications: Expo access token (expo.dev -> access tokens)
EXPO_ACCESS_TOKEN=
