# ------------------------------------------------------------------
# BidBoard environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.bidboard.build
APP_URL=http://localhost:3000

# --- Object storage ---

# Where plan sets and bid attachments live. "db" (the default) keeps them in
# Postgres and needs no cloud account; "r2" uses Cloudflare R2 and needs the four
# variables below. Rows remember the driver they were written with, so switching
# never orphans what is already stored.
STORAGE_DRIVER=db

# Per-file upload ceiling in bytes. Defaults to 12 MB, which is what the Postgres
# driver is sized for; raise it when using R2.
MAX_UPLOAD_BYTES=12582912

# Plan sets and bid attachments. R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for Resend delivery webhooks (opens/bounces feed the
# invitation status board). Resend dashboard -> Webhooks.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Default From address for invites and notices (verified domain).
EMAIL_FROM="BidBoard <invites@bidboard.build>"

# --- Stripe (our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key. NOT USED at MVP: checkout is a redirect to Stripe-hosted
# Checkout, so no Stripe code runs in the browser. Kept for a future embedded flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev: from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_CREW=your-stripe-price-id-crew
STRIPE_PRICE_BUILDER=your-stripe-price-id-builder
STRIPE_PRICE_PRECON=your-stripe-price-id-precon

# --- Auth ---

# Signing secret for the estimator session cookie (scrypt password hashing + a
# signed JWT via jose). REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth. NOT USED at MVP: sign-in is email + password only, so nothing
# reads these. They are here for when a social provider is added.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# Signing secret for sub portal tokens (the no-login bid links). REQUIRED, and
# separate from AUTH_SECRET on purpose: rotating this invalidates every
# outstanding bid link without signing out a single estimator.
# Generate with: openssl rand -base64 32
PORTAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret Vercel Cron sends to /api/jobs/* routes so only the
# scheduler can trigger reminder sweeps. Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Observability (optional in dev) ---

# Sentry DSN. NOT USED at MVP: no Sentry SDK is installed yet (ROADMAP Phase 0).
SENTRY_DSN=

# Set to "1" to log outbound email instead of sending (safety switch
# for dev against imported real sub contacts).
DRY_RUN=1
