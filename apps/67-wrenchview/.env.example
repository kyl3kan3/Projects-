# ------------------------------------------------------------------
# WrenchView environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/wrenchview?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for customer report links + tablet device tokens (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- SMS (Twilio: report links + status callbacks) ---

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550100

# --- Media (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=wrenchview-media

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_BAY=your-bay-price-id
STRIPE_PRICE_SHOP=your-shop-price-id
STRIPE_PRICE_GARAGE_GROUP=your-garage-group-price-id

# --- Email (Resend: follow-ups + report copies) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="WrenchView <service@mail.wrenchview.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" disables outbound SMS/email and logs instead (prints report
# links to stdout for local testing).
DRY_RUN=1
