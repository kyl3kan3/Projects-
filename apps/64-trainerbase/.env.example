# ------------------------------------------------------------------
# TrainerBase environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/trainerbase?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret (trainers). openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for client magic-link tokens (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (Connect for client billing; Billing for TrainerBase) ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret
STRIPE_PRICE_COACH=your-coach-price-id
STRIPE_PRICE_STUDIO=your-studio-price-id
STRIPE_PRICE_ROSTER=your-roster-price-id

# --- Check-in photos (Cloudflare R2, private bucket) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=trainerbase-media

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="TrainerBase <coach@mail.trainerbase.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" disables outbound email and Stripe calls, logging instead.
DRY_RUN=1
