# ------------------------------------------------------------------
# Dunly environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (use the pooled connection string for the app,
# the direct one for drizzle-kit migrations). https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Get from Upstash dashboard ->
# your database -> "Redis Connect" (use the TLS rediss:// URL).
# https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.dunly.com
APP_URL=http://localhost:3000

# --- Stripe (platform account) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use a Stripe test-mode secret in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (used by Stripe Elements on the hosted card-update page).
# Same page as the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret for the Connect webhook endpoint.
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# For local dev, from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Stripe Connect OAuth client ID. Stripe Dashboard -> Settings ->
# Connect -> Onboarding options -> OAuth. https://dashboard.stripe.com/settings/connect
STRIPE_CONNECT_CLIENT_ID=your-stripe-connect-client-id

# Stripe Billing price IDs for Dunly's own plans.
STRIPE_PRICE_STARTER=your-starter-plan-price-id
STRIPE_PRICE_GROWTH=your-growth-plan-price-id
STRIPE_PRICE_SCALE=your-scale-plan-price-id
STRIPE_PRICE_PERFORMANCE=your-performance-plan-price-id

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create.
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for system + dunning emails (must be on a domain
# verified in Resend -> Domains).
EMAIL_FROM="Dunly <notifications@mail.dunly.com>"

# Signing secret for Resend delivery webhooks (bounce/complaint/open events).
# Resend dashboard -> Webhooks -> your endpoint.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# --- SMS (Twilio) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info" panel).
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number. Twilio Console -> Phone Numbers -> Manage ->
# Active numbers (must be attached to an approved 10DLC campaign for US traffic).
TWILIO_FROM_NUMBER=your-twilio-sending-number

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for signing card-update page tokens (JWTs in dunning emails/SMS).
# Generate with: openssl rand -base64 32
CARD_UPDATE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
# https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety switch
# for local dev and staging against live-mode data).
DRY_RUN=1
