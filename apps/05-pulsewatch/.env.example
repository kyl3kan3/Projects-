# Copy to .env.local — Next reads that automatically, and so do the workers.
# Every value here is a placeholder; never commit real keys.

# --- Database (neon.tech, or any Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/pulsewatch

# --- Redis (OPTIONAL) ---
# Set it and PulseWatch runs the queued shape: a scheduler process, regional
# probe workers, and an alert dispatcher. Leave it unset and one cron-triggered
# function does all three inline, single-region. See DEPLOYING.md.
# REDIS_URL=redis://localhost:6379

# --- Auth ---
# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Heartbeat ping URLs are handed to customers' cron jobs. Give this its own
# hostname in production so a dashboard outage can never stop accepting pings.
NEXT_PUBLIC_PING_BASE_URL=http://localhost:3000
# Public status pages. A separate host in production, for the same reason.
NEXT_PUBLIC_STATUS_BASE_URL=http://localhost:3000

# --- Serverless scheduler (Vercel + Neon, no Redis) ---
# Shared secret for /api/cron/tick. Vercel sends it as an Authorization bearer
# token automatically; the route refuses to run without it. openssl rand -hex 32
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional tick tuning — see DEPLOYING.md.
# CRON_CONCURRENCY=12
# CRON_MAX_PER_TICK=300
# CRON_TICK_BUDGET_MS=50000

# --- Probe fleet (only for the queued shape; omit REDIS_URL to go serverless) ---
# The region this probe process reports as; set per Fly.io machine.
PROBE_REGION=iad
# Every region the scheduler fans checks out to (comma separated).
PROBE_REGIONS=iad,fra,sin
# Optional: concurrent checks per probe machine (default 25).
# PROBE_CONCURRENCY=25
# Optional: scheduler dispatch tick in ms (default 1000).
# SCHEDULER_TICK_MS=1000
# Note: probes speak only to Redis and never to Postgres, so they need no
# database credential and no API token of their own.

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price IDs for the two paid tiers (dashboard.stripe.com/products).
STRIPE_PRICE_SOLO=your-stripe-price-id-for-solo
STRIPE_PRICE_TEAM=your-stripe-price-id-for-team

# --- Email alerts (resend.com/api-keys) ---
# Optional in development: with no key, alert emails are logged, not sent.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=PulseWatch <alerts@pulsewatch.dev>

# --- Post-MVP, nothing reads these yet ---
# SMS alerting is a Team-tier feature in Phase 3 (see ROADMAP.md).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GitHub OAuth sign-in is Phase 1 polish; email/password is the MVP path.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
