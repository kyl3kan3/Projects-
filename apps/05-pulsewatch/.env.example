# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/pulsewatch
# Redis for the check-scheduler queue (Upstash or local)
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Alert channels ---
RESEND_API_KEY=            # email alerts (resend.com)
TWILIO_ACCOUNT_SID=        # SMS alerts (twilio.com/console)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Probe workers ---
# Region name this probe instance reports as (e.g. iad, fra, syd)
PROBE_REGION=iad
# Shared secret probes use to authenticate with the API
PROBE_API_TOKEN=change-me

NEXT_PUBLIC_APP_URL=http://localhost:3000
