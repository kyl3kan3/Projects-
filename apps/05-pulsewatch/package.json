{
  "name": "pulsewatch",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime, cron-job and SSL monitoring with status pages for indie devs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "next lint",
    "worker:scheduler": "tsx src/scheduler/index.ts",
    "worker:probe": "tsx src/probe/worker.ts",
    "worker:alerts": "tsx src/alerts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "bullmq": "^5.30.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.5.0",
    "twilio": "^5.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "drizzle-kit": "^0.30.0",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0"
  }
}
