# ------------------------------------------------------------------
# GrantGrid environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/grantgrid?sslmode=require

# Redis connection string for BullMQ. Upstash dashboard -> your database
# -> "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.grantgrid.org
APP_URL=http://localhost:3000

# --- Stripe ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SEED=price_xxx
STRIPE_PRICE_GROW=price_xxx
STRIPE_PRICE_FIELD=price_xxx

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for reminders and digests (domain verified in
# Resend -> Domains).
EMAIL_FROM="GrantGrid <reminders@mail.grantgrid.org>"

# --- Funder data ingestion ---

# Base URL for IRS 990 bulk data indexes (public data; override only
# for testing against fixtures). https://www.irs.gov/charities-non-profits/form-990-series-downloads
IRS_990_INDEX_URL=https://apps.irs.gov/pub/epostcard/990/xml

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials.
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx

# --- App secrets ---

# HMAC secret for signing ICS calendar-feed tokens.
# Generate with: openssl rand -base64 32
ICS_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and log instead (safety switch
# for local dev and staging).
DRY_RUN=1
