# ------------------------------------------------------------------
# GrantGrid environment variables
# Copy to .env.local (Next.js app) and .env (drizzle-kit, worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the POOLED url (host contains "-pooler") for the app and the
# DIRECT url for drizzle-kit migrations. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/grantgrid?sslmode=require

# Public base URL of the app. Local dev: http://localhost:3049.
# Production: your deployed domain, e.g. https://app.grantgrid.org
# Used in reminder emails, the ICS feed and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3049

# Session cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Shared secret for /api/cron/tick, the nightly deadline sweep. Vercel sends it
# as "Authorization: Bearer <value>". The route REFUSES TO RUN when this is
# unset rather than defaulting to open — it sends email on the account's behalf.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional. How long one sweep may run before it stops and lets the next
# invocation continue. Defaults to 50000 (50s), well inside Vercel's limit.
CRON_TICK_BUDGET_MS=

# Optional, only for `npm run worker` (a long-lived host instead of Vercel cron).
# How often the interval worker sweeps, in milliseconds. Defaults to hourly.
SWEEP_INTERVAL_MS=

# --- Stripe ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products). Each may be a
# single monthly price, or "monthly,annual" to offer both intervals.
STRIPE_PRICE_SEED=your-seed-monthly-price-id,your-seed-annual-price-id
STRIPE_PRICE_GROW=your-grow-monthly-price-id,your-grow-annual-price-id
STRIPE_PRICE_FIELD=your-field-monthly-price-id,your-field-annual-price-id

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
# Unset means reminders are logged instead of sent, and the ledger records them
# as suppressed rather than as delivered.
RESEND_API_KEY=your-resend-api-key

# Default From address for reminders (domain verified in Resend -> Domains).
EMAIL_FROM="GrantGrid <reminders@mail.grantgrid.org>"

# Set to "1" to suppress all outbound email and log instead — the safety switch
# for local development and staging.
DRY_RUN=1

# --- App secrets ---

# HMAC secret for signing ICS calendar-feed tokens. Falls back to AUTH_SECRET if
# unset, but give it its own value in production: rotating one should not
# invalidate every session. Generate with: openssl rand -base64 32
ICS_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Funder data ingestion ---

# Base URL for the IRS 990 bulk-data indexes (public data; override only to run
# against local fixtures).
# https://www.irs.gov/charities-non-profits/form-990-series-downloads
IRS_990_INDEX_URL=https://apps.irs.gov/pub/epostcard/990/xml
