{
  "name": "grantgrid",
  "version": "0.1.0",
  "private": true,
  "description": "Grant pipeline, curated discovery, and answer library for small nonprofits",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
