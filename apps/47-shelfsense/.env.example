# ------------------------------------------------------------------
# ShelfSense environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (use the pooled connection string for the app,
# the direct one for drizzle-kit migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/shelfsense?sslmode=require

# Redis connection string for BullMQ. Get from Upstash dashboard ->
# your database -> "Redis Connect" (use the TLS rediss:// URL).
# https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: use a tunnel (Shopify requires
# HTTPS for OAuth + webhooks), e.g. the URL from `shopify app dev` or ngrok.
# Production: your deployed domain, e.g. https://app.shelfsense.dev
APP_URL=https://your-tunnel.example.dev

# --- Shopify (Partner app) ---

# API key + secret for your app. Shopify Partners dashboard -> Apps ->
# your app -> Client credentials. https://partners.shopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# Comma-separated OAuth scopes. Keep least-privilege; must match the
# scopes configured in the Partner dashboard.
SHOPIFY_SCOPES=read_products,read_inventory,read_orders

# The app URL slug Shopify redirects to after install; must be listed in
# the app's allowed redirection URLs in the Partner dashboard.
SHOPIFY_REDIRECT_PATH=/api/auth/shopify/callback

# --- Encryption ---

# 32-byte key (base64) for encrypting stored shop access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for digests and PO emails (must be on a domain
# verified in Resend -> Domains).
EMAIL_FROM="ShelfSense <orders@mail.shelfsense.dev>"

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
# https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email (digests, PO sends) and log
# instead — safety switch for local dev against live shops.
DRY_RUN=1
