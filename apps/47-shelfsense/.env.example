# ------------------------------------------------------------------
# ShelfSense environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Only DATABASE_URL and AUTH_SECRET are needed to boot: the app runs with no
# Shopify credentials (the install button disables itself and says why, and the
# labelled demo store still exercises the real import and forecast) and with no
# Resend key (digests and POs are composed and recorded, not delivered).
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from the Neon dashboard -> your project ->
# Connection Details. Use the *pooled* string (the host with -pooler in it) for
# the app and the direct one for drizzle-kit migrations. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/shelfsense?sslmode=require

# Signs the session cookie and derives the at-rest key for Shopify access
# tokens. Rotating it invalidates both, so merchants reinstall — the safe
# failure direction. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL of the app. Local dev: use a tunnel (Shopify requires HTTPS
# for OAuth and webhooks), e.g. the URL from `shopify app dev` or ngrok.
# Production: your deployed domain, e.g. https://app.shelfsense.dev
APP_URL=https://your-tunnel.example.dev

# --- Shopify (Partner app) ---
# Leave blank to run without Shopify: the connect screen disables the install
# button and offers the labelled demo store instead.

# API key + secret for your app. Shopify Partners dashboard -> Apps ->
# your app -> Client credentials. https://partners.shopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# Comma-separated OAuth scopes. Keep least-privilege; must match the scopes
# configured in the Partner dashboard.
SHOPIFY_SCOPES=read_products,read_inventory,read_orders

# Path Shopify redirects to after install. Must be listed in the app's allowed
# redirection URLs in the Partner dashboard, as APP_URL + this path.
SHOPIFY_REDIRECT_PATH=/api/shopify/callback

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create. https://resend.com/api-keys
# With this unset, digests and PO emails are composed and recorded as
# suppressed rather than sent.
RESEND_API_KEY=

# Default From address for digests and PO emails. Must be on a domain verified
# in Resend -> Domains.
EMAIL_FROM="ShelfSense <orders@mail.shelfsense.dev>"

# --- Background work ---

# Shared secret for /api/cron/tick, which applies webhook deliveries, advances
# backfills, runs the nightly recompute and sends digests. Vercel Cron sends it
# as `Authorization: Bearer <value>`. The route refuses every request when this
# is unset rather than defaulting to open. Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: how long one tick may run before it stops and lets the next one
# continue, in milliseconds. Defaults to 45000.
CRON_TICK_BUDGET_MS=

# Set to "1" to compose but never deliver email (digests, PO sends) — the
# safety switch for pointing a dev environment at a live shop.
DRY_RUN=1

# Nothing reads a Sentry DSN yet — error reporting is Phase 0 infrastructure that
# this MVP has not wired, and a placeholder for a variable no code reads is worse
# than no placeholder.
