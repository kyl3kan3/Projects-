# --- Core ---
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/parseflow
REDIS_URL=redis://localhost:6379/0

# --- LLM extraction (console.anthropic.com) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
EXTRACTION_MODEL=claude-sonnet-5

# --- Billing: metered usage (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_METERED_PRICE_ID=   # price for per-page usage

# --- Document storage (S3/R2; temporary, docs deleted after retention window) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=parseflow-docs
DOC_RETENTION_HOURS=24

# --- API ---
# Secret used to sign webhook callbacks to customers
WEBHOOK_SIGNING_SECRET=change-me
API_BASE_URL=http://localhost:8000
