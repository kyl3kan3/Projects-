# ------------------------------------------------------------------
# ListingLoop environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/listingloop?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for party portal/upload tokens (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_SOLO=your-solo-price-id
STRIPE_PRICE_DESK=your-desk-price-id
STRIPE_PRICE_OFFICE=your-office-price-id

# --- Documents (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=listingloop-documents

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="ListingLoop <files@mail.listingloop.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" disables outbound email and logs instead.
DRY_RUN=1
