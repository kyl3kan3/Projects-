# ------------------------------------------------------------------
# ListingLoop environment variables
# Copy to .env — read by the app, the worker, db:migrate and db:seed.
# Never commit real values.
#
# Only DATABASE_URL, SESSION_SECRET and LINK_TOKEN_SECRET are required to run.
# Everything else degrades honestly, and /settings says which way:
#   no RESEND_API_KEY  -> reminders are recorded in the ledger and logged
#   no R2_*            -> documents are stored as bytes in Postgres
#   no STRIPE_*        -> the billing screen lists plans without a checkout
#   no REDIS_URL       -> recomputes run inline, /api/cron/tick does the nightly pass
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/listingloop?sslmode=require
APP_URL=http://localhost:3065

# Optional. Set it to run the standalone worker (`npm run worker`); leave it unset
# on Vercel, where /api/cron/tick does the same work on a schedule.
REDIS_URL=rediss://default:password@example.upstash.io:6379

# --- Auth ---

# Signs the console session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Signs the party portal links, which are bearer credentials for reading a
# transaction and putting documents into it. A separate secret on purpose:
# rotating it invalidates every portal link without logging anybody out.
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_SOLO=your-solo-price-id
STRIPE_PRICE_DESK=your-desk-price-id
STRIPE_PRICE_OFFICE=your-office-price-id

# --- Documents (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=listingloop-documents

# --- Email (Resend: reminders and document requests) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="ListingLoop <files@mail.listingloop.app>"

# --- Scheduled work ---

# Bearer token for GET /api/cron/tick (Vercel Cron). The route refuses to run
# when this is unset rather than defaulting to open.
CRON_SECRET=generate-with-openssl-rand-base64-32

# How long one tick may run before it stops and lets the next one continue.
CRON_TICK_BUDGET_MS=50000

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Delivery ---

# Set to "1" to log outbound email instead of sending it. Reminders are still
# recorded in the ledger, so exactly-once behaviour is identical either way.
DRY_RUN=1
