# --- Database (Neon: use the pooled -pooler host) ---
DATABASE_URL=postgres://user:password@localhost:5432/papertrail

# --- Auth: signs the session cookie. Generate one per environment ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Payments (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Subscription prices for PaperTrail itself (dashboard.stripe.com/products)
STRIPE_PRICE_SOLO=your-stripe-price-id-for-the-solo-plan
STRIPE_PRICE_STUDIO=your-stripe-price-id-for-the-studio-plan

# --- Email (resend.com/api-keys) ---
# Unset: documents are still prepared and their share links work, but nothing
# is emailed — every attempt is logged on the document timeline as undelivered.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=PaperTrail <docs@your-domain.example>

# --- Cron: the late-payment reminder sweep ---
# Vercel sends this as "Authorization: Bearer ...". The route refuses to run
# when this is unset, rather than defaulting to open.
CRON_SECRET=generate-a-long-random-string

NEXT_PUBLIC_APP_URL=http://localhost:3000
