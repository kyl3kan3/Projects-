# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/papertrail
REDIS_URL=redis://localhost:6379

# --- Auth (magic-link email login) ---
AUTH_SECRET=change-me

# --- Payments (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (resend.com/api-keys) ---
RESEND_API_KEY=
EMAIL_FROM=docs@papertrail.app

# --- PDF + asset storage (S3/R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=papertrail-docs

NEXT_PUBLIC_APP_URL=http://localhost:3000
