# ------------------------------------------------------------------
# TenantFile environment variables
# Copy to .env.local (the Next.js app reads it) and .env (the worker reads it).
# Never commit real values.
#
# Only the four vars in "Required" are needed to run the whole product locally.
# Everything else turns on an integration; without it, that integration is off and
# the app says so on screen rather than failing quietly.
# ------------------------------------------------------------------

# --- Required ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (use the pooled URL for the app, the direct URL for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=your-postgres-connection-string

# Session cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Signs the tokens in tenant pay-page, screening and lease-signing links. Kept
# separate from AUTH_SECRET so rotating link tokens does not sign every landlord
# out. Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Public base URL, used in every emailed link. Local dev: http://localhost:3044
APP_URL=http://localhost:3044

# --- Scheduled work ---

# Shared secret for /api/cron/tick (charge generation, late fees, reminder
# sends). The endpoint REFUSES TO RUN when this is unset — an open trigger that
# can text every tenant is not something to leave lying around.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# How long a single tick may run before it defers the rest to the next one.
# CRON_TICK_BUDGET_MS=45000

# Interval for the standalone worker (`npm run worker`), in milliseconds.
# TICK_INTERVAL_MS=300000

# --- Object storage (listing photos, applicant documents, leases, exports) ---

# "local" writes to LOCAL_STORAGE_DIR through the filesystem adapter, which is
# the adapter implemented in this build. Storage sits behind an interface
# (src/lib/storage.ts) so an S3/R2 adapter can be added without touching
# anything else.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# --- Email (Resend) ---

# API key. https://resend.com/api-keys
# Leave blank and reminders are written to the log instead of being sent.
RESEND_API_KEY=

# Default From address, on a domain verified in Resend -> Domains.
EMAIL_FROM="TenantFile <notifications@your-verified-domain>"

# --- SMS (Twilio REST API; no SDK) ---

# Console home page, "Account Info". https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number on an approved 10DLC campaign (US).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# Set to "1" to log outbound email and SMS instead of sending them. Defaults to
# ON whenever RESEND_API_KEY is unset, so a local run can never text a real
# tenant by accident.
DRY_RUN=1

# --- Stripe (our subscriptions, and rent on the landlord's connected account) ---

# Secret API key. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key, for Stripe Elements on the tenant pay page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev: whatever `stripe listen` prints.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Recurring price ids for the three plans in README.md.
STRIPE_PRICE_KEYS=your-stripe-price-id-for-keys
STRIPE_PRICE_BUILDING=your-stripe-price-id-for-building
STRIPE_PRICE_PORTFOLIO=your-stripe-price-id-for-portfolio

# --- Observability (optional) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=
