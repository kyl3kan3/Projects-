# ------------------------------------------------------------------
# TenantFile environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (pooled URL for the app, direct URL for drizzle-kit migrations).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (TLS rediss:// URL). https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.tenantfile.com
APP_URL=http://localhost:3000

# --- Object storage (Cloudflare R2, S3-compatible) ---

# R2 dashboard -> your bucket -> Settings; API tokens under
# "Manage R2 API Tokens". https://dash.cloudflare.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Screening provider (SmartMove-class partner API) ---

# Issued during partner onboarding with your screening provider.
SCREENING_API_KEY=your-screening-provider-api-key
SCREENING_WEBHOOK_SECRET=your-screening-provider-webhook-secret

# --- Lease e-sign (Dropbox Sign-class embedded signing) ---

# App console -> API keys. The client id enables embedded signing.
ESIGN_API_KEY=your-esign-provider-api-key
ESIGN_CLIENT_ID=your-esign-embedded-client-id
ESIGN_WEBHOOK_SECRET=your-esign-provider-webhook-secret

# --- Stripe (rent via Connect + our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (Stripe Elements on the tenant pay page).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (Resend) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="TenantFile <notifications@your-verified-domain>"

# Signing secret for Resend delivery webhooks.
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- SMS (Twilio) ---

# Console home page ("Account Info" panel). https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number attached to an approved 10DLC campaign (US).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider).
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for signing tenant pay-page and applicant links.
# Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety switch
# for local dev and staging against live tenancies).
DRY_RUN=1
