# ------------------------------------------------------------------
# RosterRally environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (pooled URL for the app, direct URL for drizzle-kit migrations).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (TLS rediss:// URL). https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.rosterrally.com
APP_URL=http://localhost:3000

# --- Stripe (registration payments via Connect + our billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (checkout on the public registration page).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Our per-registration application fee, in cents (default 150 = $1.50).
APPLICATION_FEE_CENTS=150

# --- Email (Resend) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="RosterRally <notifications@your-verified-domain>"

# Signing secret for Resend delivery/open/click webhooks (read receipts).
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- SMS (Twilio) ---

# Console home page ("Account Info" panel). https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number attached to an approved 10DLC campaign (US).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider for club staff).
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for signing parent link-page and volunteer-claim tokens.
# Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Encryption key for player medical notes at rest.
# Generate with: openssl rand -base64 32
MEDICAL_FIELD_KEY=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety switch
# for local dev and staging against live club data).
DRY_RUN=1
