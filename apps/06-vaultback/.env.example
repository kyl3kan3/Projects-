# Copy to .env.local — Next reads that automatically, and so does the worker.
# Every value here is a placeholder. Never commit real keys.

# --- Control-plane database (neon.tech, or any Postgres) ---
# This holds metadata only: it never contains a customer's row data.
DATABASE_URL=postgres://user:pass@localhost:5432/vaultback

# --- Auth ---
# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Encryption (both required) ---
# Wraps the per-snapshot AES-256-GCM data keys (envelope encryption). Losing
# this makes every stored snapshot unreadable, so back it up somewhere that is
# not this database.              openssl rand -hex 32
BACKUP_MASTER_KEY=generate-a-32-byte-random-hex-string
# Encrypts customer connection strings and bucket credentials at rest.
# Deliberately a different key: compromising one must not decrypt the other.
CREDENTIALS_KEY=generate-a-different-32-byte-random-hex-string

# --- Public URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3006

# --- Scheduler (cron-triggered route) ---
# Shared secret for /api/cron/tick. Vercel sends it as an Authorization bearer
# token automatically; the route refuses to run when the variable is unset.
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional tick tuning — see DEPLOYING.md.
# CRON_TICK_BUDGET_MS=50000
# CRON_CONCURRENCY=3
# CRON_MAX_BACKUPS=25
# CRON_MAX_DRILLS=2

# --- Managed snapshot storage (the default target for every organization) ---
# Any S3-compatible bucket. Set S3_ENDPOINT for Cloudflare R2; leave it empty
# for AWS S3. With none of these set, development writes snapshots to
# LOCAL_STORAGE_DIR instead — still gzipped and still encrypted. That fallback
# refuses to run on Vercel, where the filesystem is ephemeral.
S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-backup-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# LOCAL_STORAGE_DIR=.vaultback-storage

# --- Scratch Postgres for restore drills ---
# A server VaultBack owns. Each drill creates a database on it, restores into
# it, verifies, and drops it. Never point this at a customer's database.
# Defaults to DATABASE_URL in development.
SCRATCH_POSTGRES_URL=postgres://user:pass@localhost:5432/postgres

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price IDs for the three tiers (dashboard.stripe.com/products).
STRIPE_PRICE_HOBBY=your-stripe-price-id-for-hobby
STRIPE_PRICE_STARTUP=your-stripe-price-id-for-startup
STRIPE_PRICE_BUSINESS=your-stripe-price-id-for-business

# --- Alert email (resend.com/api-keys) ---
# Optional in development: with no key, alerts are logged instead of sent.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=VaultBack <alerts@vaultback.dev>

# --- GitHub sign-in (optional) ---
# github.com/settings/developers — the callback URL is
# {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
# With these unset the button is hidden and the OAuth routes return 404.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Dump engine (optional) ---
# auto (default) uses pg_dump when it is present and at least as new as the
# source server, and the built-in TypeScript dumper otherwise. Force one with
# "pg_dump" or "js" to reproduce a customer's environment.
# VAULTBACK_DUMP_ENGINE=auto
# PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
# Read an object back after upload and re-hash it, when it is under this size.
# VERIFY_READBACK_MAX_BYTES=536870912

# --- Long-lived worker (optional; see DEPLOYING.md) ---
# WORKER_TICK_MS=20000
# WORKER_BUDGET_MS=900000
# A job still "running" after this long is treated as abandoned and failed.
# Must exceed your longest dump, or the watchdog cries wolf.
# STUCK_JOB_TIMEOUT_MS=2700000
# Redis is declared in package.json for the queued shape in ARCHITECTURE.md,
# but nothing imports it — the job queue lives in Postgres. DEPLOYING.md
# explains why, and what would change if Redis were reintroduced.
# REDIS_URL=redis://localhost:6379
