# --- Control-plane database ---
DATABASE_URL=postgres://user:pass@localhost:5432/vaultback
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Default backup storage (our-bucket plan; customers can BYO bucket) ---
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vaultback-backups

# --- Encryption ---
# 32-byte hex master key for envelope encryption of backup data keys
# generate: `openssl rand -hex 32`
BACKUP_MASTER_KEY=

# --- Notifications ---
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
