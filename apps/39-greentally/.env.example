# ------------------------------------------------------------------
# GreenTally environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Two variables are required to run the product. Everything else degrades
# honestly: with no Anthropic key, bills are read from their PDF text layer and a
# scan lands in review with empty fields instead of a guessed number; with no R2
# credentials, original bills are stored as bytes in Postgres; with no Stripe
# key, the billing screen shows the plans and says checkout is unavailable.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the pooled URL for the app and the direct URL for drizzle-kit
# migrations. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/greentally?sslmode=require

# Signing secret for the session cookie (30-day expiry) and, unless
# SIGNING_SECRET is set separately, for signed document and report-render links.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL. Local dev: http://localhost:3039. Production: your deployed
# domain. Stripe redirects and the PDF renderer are built from this.
APP_URL=http://localhost:3039

# --- Scheduled work ---

# Shared secret protecting /api/cron/tick, which sweeps the job queue
# (extraction, spend classification, footprint recompute). The route refuses to
# run when this is unset rather than defaulting to open.
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional: how often the long-lived worker polls, in milliseconds. Only used by
# `npm run worker`; on Vercel the in-browser drain plus the daily cron is enough.
WORKER_INTERVAL_MS=3000

# --- Bill extraction (optional: Anthropic) ---

# API key. https://console.anthropic.com -> API keys.
# Without it, extraction uses the deterministic PDF text-layer reader. That is a
# real driver, not a stub, but it cannot read a photograph of a bill.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Models. The default is the cheap one, because a bill page is a small job.
EXTRACTION_MODEL=claude-haiku-4-5-20251001
EXTRACTION_ESCALATION_MODEL=claude-sonnet-5

# --- Object storage (optional: Cloudflare R2) ---

# When these four are unset, original bills are stored as base64 in Postgres and
# served through the same signed-link route. Both paths keep documents private.
# Cloudflare dashboard -> R2 -> Manage API tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=greentally-documents

# --- Signed links (optional) ---

# Signs document URLs and report-render tokens. Falls back to AUTH_SECRET so a
# local checkout works from one generated secret; keep them separate in
# production, because render tokens are handed to a headless browser.
SIGNING_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (optional: billing) ---

# Secret key. Stripe Dashboard -> Developers -> API keys. Use a test key in
# development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Dashboard -> Developers -> Webhooks, or from
# `stripe listen` locally. Point the endpoint at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans, monthly and annual (Dashboard -> Products).
# When a price ID is missing, checkout falls back to an inline price at the
# figure in src/lib/plans.ts, so a fresh Stripe account still works.
STRIPE_PRICE_STARTER_MONTHLY=your-stripe-price-id-starter-monthly
STRIPE_PRICE_STARTER_ANNUAL=your-stripe-price-id-starter-annual
STRIPE_PRICE_STANDARD_MONTHLY=your-stripe-price-id-standard-monthly
STRIPE_PRICE_STANDARD_ANNUAL=your-stripe-price-id-standard-annual
STRIPE_PRICE_SUPPLIER_PLUS_MONTHLY=your-stripe-price-id-supplier-plus-monthly
STRIPE_PRICE_SUPPLIER_PLUS_ANNUAL=your-stripe-price-id-supplier-plus-annual
