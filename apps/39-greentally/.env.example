# ------------------------------------------------------------------
# GreenTally environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled string for the app, direct for migrations).
# https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/greentally?sslmode=require

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.greentally.com
APP_URL=http://localhost:3000

# --- Document storage (Cloudflare R2, S3-compatible) ---

# R2 dashboard -> your bucket -> Settings; API tokens under
# "Manage R2 API Tokens". https://dash.cloudflare.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=greentally-documents

# --- Extraction (Anthropic) ---

# API key for bill extraction and spend classification.
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used by the extraction pipeline (vision-capable).
EXTRACTION_MODEL=claude-sonnet-5

# --- Billing (Stripe) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (+ annual variants), from
# Stripe Dashboard -> Products.
STRIPE_PRICE_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_STANDARD_MONTHLY=price_xxx
STRIPE_PRICE_SUPPLIER_PLUS_MONTHLY=price_xxx

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials. https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx

# --- Email (Resend) ---

# API key for magic links and lifecycle email. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="GreenTally <notifications@mail.greentally.com>"

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# --- Worker ---

# Set to "1" to skip real Anthropic calls and use fixture extractions
# (safety + cost switch for local dev).
DRY_RUN=1
