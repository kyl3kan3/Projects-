{
  "name": "priceprobe",
  "version": "0.1.0",
  "private": true,
  "description": "Competitor price monitoring for small e-commerce brands: polite scrape workers, price/stock alerts, position dashboards, and repricing suggestions that never auto-push",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "bullmq": "^5.44.0",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "ioredis": "5.10.1",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "robots-parser": "^3.0.1",
    "stripe": "^18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
