# ------------------------------------------------------------------
# CrewClock environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (pooled for the app, direct for migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@your-neon-host/crewclock?sslmode=require

# Redis connection string for BullMQ. Get from Upstash dashboard ->
# your database -> "Redis Connect" (use the TLS rediss:// URL).
# https://console.upstash.com
REDIS_URL=rediss://default:your-upstash-password@your-upstash-host:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.crewclock.com
APP_URL=http://localhost:3000

# --- Stripe (our own billing: per-seat subscriptions) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use the test-mode key in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (used by Stripe.js on the checkout/billing pages).
# Same page as the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret for our billing webhook endpoint.
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# For local dev, from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Per-seat price IDs. Stripe Dashboard -> Product catalog -> Pricing. One
# recurring per-unit price per plan ($8 Crew, $12 Company; annual variants too).
STRIPE_PRICE_CREW_MONTHLY=your-crew-plan-price-id
STRIPE_PRICE_COMPANY_MONTHLY=your-company-plan-price-id

# --- Maps (job-site geofences, clock-in mini-map) ---

# Mapbox public access token for the static mini-map and site picker.
# Mapbox account -> Access tokens. https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create.
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for alerts, digests, and export delivery (must be on
# a domain verified in Resend -> Domains).
EMAIL_FROM="CrewClock <alerts@mail.crewclock.com>"

# --- SMS (Twilio, optional: OT and budget alerts by text) ---
# Leave blank to disable SMS entirely; the app falls back to email alerts.
# Account SID and Auth Token: Twilio Console home page ("Account Info" panel).
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sending number. Twilio Console -> Phone Numbers -> Manage ->
# Active numbers (must be attached to an approved 10DLC campaign for US traffic).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- App secrets ---

# HMAC secret for signing crew invite codes and QR join tokens.
# Generate with: openssl rand -base64 32
INVITE_CODE_SIGNING_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
# https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email/SMS and log instead (safety switch
# for local dev and staging against real crew data).
DRY_RUN=1
