# ------------------------------------------------------------------
# CrewClock environment variables
#
# Copy to .env.local and fill in. Next.js reads .env.local automatically, and
# so does the standalone worker (npm run worker). Never commit real values.
#
# Only DATABASE_URL and AUTH_SECRET are required to run the product. Everything
# else switches a feature on: with no Stripe keys the billing screen says so
# instead of breaking, and with no Resend key alerts are logged rather than sent.
# ------------------------------------------------------------------

# --- Required ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (use the pooled endpoint for the app, the direct one for migrations).
# https://console.neon.tech
DATABASE_URL=postgresql://user:password@your-neon-host/crewclock?sslmode=require

# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Public URLs ---

# Public base URL of the app. Local dev: http://localhost:3033.
# Production: your deployed domain, e.g. https://app.crewclock.com
NEXT_PUBLIC_APP_URL=http://localhost:3033

# --- Scheduled work ---
#
# The overtime projection scan, the 80%/100% budget checks and the
# forgotten-clock-out sweep all run in one idempotent tick. Reach it either way:
#   - Vercel Cron / any scheduler hitting GET /api/cron/tick with this bearer
#     token (see vercel.json). The route refuses to run when the secret is unset,
#     so it is never an open trigger.
#   - `npm run worker` on an always-on host (Railway/Fly), which calls the same
#     function on an interval. Running both is harmless; the tick is idempotent.
#
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional: how long a single tick may run before deferring the rest (ms).
# CRON_TICK_BUDGET_MS=50000
# Optional: worker loop interval in ms (default 900000 = 15 minutes).
# WORKER_INTERVAL_MS=900000

# --- Billing (optional; the billing screen degrades honestly without it) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys (use the test key
# in development). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret for /api/webhooks/stripe. Stripe Dashboard ->
# Developers -> Webhooks -> your endpoint -> Signing secret. For local dev:
# stripe listen --forward-to localhost:3033/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Per-seat recurring price IDs, one per plan ($8 Crew, $12 Company). The $49
# monthly minimum is applied as an invoice adjustment, not by inflating the
# quantity, so the customer's invoice reads honestly.
STRIPE_PRICE_CREW_MONTHLY=your-crew-plan-price-id
STRIPE_PRICE_COMPANY_MONTHLY=your-company-plan-price-id

# --- Email alerts (optional: with no key, alerts are logged, not sent) ---

# resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (must be on a domain verified in Resend -> Domains).
EMAIL_FROM=CrewClock <alerts@mail.crewclock.app>

# --- SMS alerts (optional: owners live in trucks, not inboxes) ---
#
# Per-organization opt-in, set in Settings. Leave these blank to disable SMS
# entirely; email alerts still go out. US traffic needs an approved 10DLC
# campaign, which takes weeks to register.
# Account SID and Auth Token: Twilio Console home page. https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# E.164 sending number: Twilio Console -> Phone Numbers -> Active numbers.
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Safety switch ---

# "1" disables all outbound email and SMS and logs them instead. Keep this on
# for any environment pointed at real crew data.
DRY_RUN=1

# --- Optional ---

# HMAC secret for signing crew invite links, if you add QR join URLs later.
# Crew codes themselves are random and stored hashed-adjacent (see src/lib/auth.ts).
# Generate with: openssl rand -hex 32
INVITE_CODE_SIGNING_SECRET=generate-a-32-byte-random-hex-string

# Mapbox public token. Nothing in the MVP requires it: the crew mini-map is a
# plotted ground that renders with no network, and job sites are set by pasting
# coordinates. Set it only if you add real tiles to the office site picker.
# https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=
