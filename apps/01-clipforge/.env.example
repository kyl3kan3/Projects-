# --- App ---
# Public base URL of the deployed app (http://localhost:3000 in dev)
APP_URL=http://localhost:3000
# Random 32+ char secret for session/JWT signing: `openssl rand -base64 32`
AUTH_SECRET=

# --- Database ---
# Postgres connection string. Get from Neon dashboard (neon.tech) -> Connection Details
DATABASE_URL=postgres://user:pass@host:5432/clipforge

# --- Redis / queue ---
# Redis URL for BullMQ. Get from Upstash (upstash.com) -> Redis -> REST/TCP details, or redis://localhost:6379 in dev
REDIS_URL=redis://localhost:6379

# --- Object storage (Cloudflare R2, S3-compatible) ---
# Create bucket at dash.cloudflare.com -> R2. Endpoint is https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 -> Manage R2 API Tokens -> Create API token (Object Read & Write)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clipforge-media
# Public bucket/custom domain for serving rendered clips (R2 -> bucket -> Settings -> Public access)
S3_PUBLIC_BASE_URL=

# --- Stripe ---
# Dashboard -> Developers -> API keys (use test keys until launch)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard -> Developers -> Webhooks -> Add endpoint (POST /api/webhooks/stripe) -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from Dashboard -> Product catalog (create Starter/Pro/Team + overage meter first)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_OVERAGE=

# --- AI providers ---
# OpenAI API key for Whisper transcription: platform.openai.com -> API keys
OPENAI_API_KEY=
# Anthropic API key for clip selection + copy generation: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Email ---
# Resend API key: resend.com -> API Keys (verify sending domain first)
RESEND_API_KEY=
# Verified sender, e.g. notifications@clipforge.app
EMAIL_FROM=

# --- OAuth (login) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Worker ---
# Number of concurrent pipeline jobs per worker process (tune to CPU/RAM)
WORKER_CONCURRENCY=2
# Local scratch directory for ffmpeg temp files
WORKER_SCRATCH_DIR=/tmp/clipforge
