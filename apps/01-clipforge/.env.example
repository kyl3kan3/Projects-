# --- App ---
# Public base URL of the deployed app (http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ char secret for session/JWT signing: `openssl rand -base64 32`
AUTH_SECRET=

# --- Database ---
# Postgres connection string. Get from Neon dashboard (neon.tech) -> Connection Details
DATABASE_URL=postgres://user:pass@host:5432/clipforge

# --- Redis / queue ---
# Redis URL for BullMQ. Upstash (upstash.com) TCP URL, or redis://localhost:6379 in dev
REDIS_URL=redis://localhost:6379

# --- Object storage (Cloudflare R2, S3-compatible) ---
# Create bucket at dash.cloudflare.com -> R2. Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 -> Manage R2 API Tokens -> Create API token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipforge-media
# Public bucket/custom domain for serving rendered clips (R2 -> bucket -> Settings -> Public access).
# Leave blank to serve rendered clips via presigned URLs instead.
R2_PUBLIC_BASE_URL=

# --- AI providers ---
# OpenAI API key for Whisper transcription: platform.openai.com -> API keys
OPENAI_API_KEY=
# Anthropic API key for clip selection + copy generation: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5)
CLIPFORGE_MODEL=claude-sonnet-5

# --- Stripe ---
# Dashboard -> Developers -> API keys (use test keys until launch)
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> Add endpoint (POST /api/stripe/webhook) -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from Dashboard -> Product catalog (create Starter/Pro/Team + an optional overage meter)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_OVERAGE=

# --- Email (optional in dev; logs to console when unset) ---
# Resend API key: resend.com -> API Keys (verify sending domain first)
RESEND_API_KEY=
# Verified sender, e.g. "ClipForge <notifications@clipforge.app>"
EMAIL_FROM=ClipForge <noreply@clipforge.app>

# --- Worker ---
# Number of concurrent pipeline jobs per worker process (tune to CPU/RAM)
WORKER_CONCURRENCY=2
