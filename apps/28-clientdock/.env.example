# Copy to .env.local — Next reads that automatically.
# Every value here is a placeholder. Never commit real keys.

# --- Database (neon.tech, or any Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/clientdock

# --- Auth ---
# Signs both the agency session cookie and the scoped client-portal sessions.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# --- Public URL ---
# Used in magic links and notification emails when an agency has no verified
# custom domain of its own.
NEXT_PUBLIC_APP_URL=http://localhost:3028

# --- File storage ---
# "db" keeps uploads in Postgres (table file_blobs) — the only driver that works
# on Vercel, whose filesystem is read-only. "local" writes under STORAGE_DIR,
# which is nicer in development and fine on a single VPS. An S3/R2 driver drops
# in behind the same interface (src/lib/storage.ts) without touching a caller.
STORAGE_DRIVER=db
STORAGE_DIR=.data/uploads
# Per-file cap in bytes (default 10MB).
MAX_UPLOAD_BYTES=10485760

# --- Our subscription billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price IDs for the three paid tiers (dashboard.stripe.com/products).
STRIPE_PRICE_SOLO=your-stripe-price-id-for-solo
STRIPE_PRICE_AGENCY=your-stripe-price-id-for-agency
STRIPE_PRICE_STUDIO=your-stripe-price-id-for-studio
# Agencies' own Stripe accounts are onboarded through Connect using the same
# secret key above — no separate credential is needed.

# --- Email (resend.com/api-keys) ---
# Optional in development: with no key every notification is logged in full
# instead of sent, and recorded as "logged" rather than "sent".
RESEND_API_KEY=your-resend-api-key
# Fallback sender, used until an agency's own domain passes the DKIM/SPF check.
EMAIL_FROM=ClientDock <portals@clientdock.app>
# Domain that carries the per-thread reply addresses for inbound parsing.
INBOUND_EMAIL_DOMAIN=reply.clientdock.app
# Shared secret for POST /api/inbound/email. The route refuses to run when unset.
INBOUND_WEBHOOK_SECRET=generate-a-32-byte-random-hex-string

# --- Scheduled work (freshness nudges) ---
# Shared secret for /api/cron/tick. Vercel sends it as an Authorization bearer
# token automatically; the route refuses to run when this is unset.
CRON_SECRET=generate-a-32-byte-random-hex-string
# Optional tick tuning — see DEPLOYING.md in the repo root.
# CRON_TICK_BUDGET_MS=50000
