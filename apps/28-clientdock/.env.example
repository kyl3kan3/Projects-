# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/clientdock

# --- Auth ---
AUTH_SECRET=change-me

# --- Our billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Stripe Connect (for agencies' own invoicing)
STRIPE_CONNECT_CLIENT_ID=

# --- Files (S3/R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clientdock-files

# --- Email (resend.com; inbound parsing for reply threading) ---
RESEND_API_KEY=
INBOUND_EMAIL_DOMAIN=reply.clientdock.app

# --- Custom domains (vercel.com API) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
