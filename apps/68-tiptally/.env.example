# ------------------------------------------------------------------
# TipTally environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/tiptally?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for staff transparency links (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_HOUSE=your-house-price-id
STRIPE_PRICE_GROUP=your-group-price-id
STRIPE_PRICE_HOSPITALITY=your-hospitality-price-id

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="TipTally <shifts@mail.tiptally.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" disables outbound email and logs instead.
DRY_RUN=1
