# ------------------------------------------------------------------
# MatPass environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled for the app, direct for drizzle-kit).
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ (Upstash -> your database -> connect).
REDIS_URL=your-upstash-redis-connection-string

# Public base URL of the app. Local dev: http://localhost:3057.
NEXT_PUBLIC_APP_URL=http://localhost:3057

# --- Stripe (Connect platform for tuition + our own billing) ---

# Secret API key for the PLATFORM account. Stripe Dashboard ->
# Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout and hosted flows).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret for PLATFORM events (MatPass's own billing).
# Local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Webhook signing secret for CONNECT (connected-account) events —
# family tuition bills on the school's own Stripe account.
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-signing-secret

# Price IDs for MatPass's three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_DOJO=your-stripe-price-id-dojo
STRIPE_PRICE_ACADEMY=your-stripe-price-id-academy
STRIPE_PRICE_FEDERATION=your-stripe-price-id-federation

# --- Object storage (Cloudflare R2, S3-compatible) ---

# Student photos (optional, access-controlled) and waiver documents.
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Email (Resend — announcements, dunning, auth links) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for Resend delivery webhooks (announcement delivery
# status). Resend dashboard -> Webhooks.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Default From address (verified domain).
EMAIL_FROM="MatPass <mail@matpass.app>"

# --- Auth (staff accounts: scrypt + a signed JWT session cookie) ---

# Signing secret for the staff session cookie. REQUIRED in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- App secrets & policy ---

# HMAC secret for kiosk device tokens (the door tablet's only credential;
# revocable per device). Generate with: openssl rand -base64 32
KIOSK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Retention scan defaults (per-school overrides in settings): a student
# below this fraction of their own baseline cadence gets flagged...
RETENTION_BASELINE_FRACTION=0.4

# ...but only after at least this many days since their last check-in.
RETENTION_MIN_DAYS_ABSENT=10

# --- Scheduled work ---

# Shared secret for /api/cron/tick, which runs the nightly sweep: eligibility
# refresh, retention scan, dunning notices, stalled announcement resume. The
# route REFUSES TO RUN when this is unset, so an unauthenticated request can
# never email a school's parents. Vercel sends it as an Authorization bearer.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# Set to "1" to log outbound email and skip real Stripe mutations —
# safety switch for dev against imported real family data.
DRY_RUN=1
