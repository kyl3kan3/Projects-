# ------------------------------------------------------------------
# GigBag server environment variables (server/ folder).
# Copy to .env.local (Next.js) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/gigbag?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth (magic links + booker/share tokens) ---

# Session signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (Connect: deposits on the band's own account) ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# --- RevenueCat (entitlement mirror) ---

REVENUECAT_WEBHOOK_AUTH=generate-with-openssl-rand-base64-32

# --- Documents (Cloudflare R2: contract PDFs, plots) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=gigbag-documents

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="GigBag <gigs@mail.gigbag.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" disables outbound email and Stripe calls, logging instead.
DRY_RUN=1
