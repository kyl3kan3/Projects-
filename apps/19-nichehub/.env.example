# --- Per-directory deployment config ---
# Which directory config to build (maps to configs/<name>/directory.config.ts)
DIRECTORY_CONFIG=example-niche

# --- Sponsored listings (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Claim verification + outreach email (resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=hello@yourdirectory.com

# --- Build-time enrichment (optional) ---
GEOCODING_API_KEY=         # e.g. OpenCage / Google Geocoding for local niches
LOGO_FETCH_API_KEY=        # e.g. logo.dev

# --- Site ---
PUBLIC_SITE_URL=https://yourdirectory.com
