# --- Core ---
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mailprobe
REDIS_URL=redis://localhost:6379/0

# --- Billing: metered (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_METERED_PRICE_ID=

# --- Probe fleet ---
# Comma-separated probe node addresses (internal API of the SMTP fleet)
PROBE_NODES=
# Shared secret for API<->probe-node auth
PROBE_FLEET_SECRET=change-me
# HELO domain + MAIL FROM used by probes (must have proper DNS/rDNS)
PROBE_HELO_DOMAIN=probe.mailprobe.dev
PROBE_MAIL_FROM=verify@mailprobe.dev

# --- Data feeds ---
DISPOSABLE_DOMAINS_FEED_URL=   # or bundled dataset path

# --- Privacy ---
# Days to retain verification records (default 30)
RETENTION_DAYS=30
# 32-byte hex for address encryption at rest: `openssl rand -hex 32`
ADDRESS_ENCRYPTION_KEY=

# --- Bulk job storage (S3/R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mailprobe-jobs

# --- API ---
WEBHOOK_SIGNING_SECRET=change-me
API_BASE_URL=http://localhost:8000
