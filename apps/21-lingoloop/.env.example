# --- Mobile app (Expo) ---
# RevenueCat public SDK keys (app.revenuecat.com)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Session server URL
EXPO_PUBLIC_SESSION_SERVER_URL=ws://localhost:8787

# --- Session server (src/server) ---
DATABASE_URL=postgres://user:pass@localhost:5432/lingoloop
# STT (console.deepgram.com)
DEEPGRAM_API_KEY=
# Tutor LLM (console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
TUTOR_MODEL=claude-sonnet-5
# TTS (elevenlabs.io -> profile -> API key)
ELEVENLABS_API_KEY=
# RevenueCat secret key for server-side entitlement checks
REVENUECAT_SECRET_KEY=
# Session auth signing
JWT_SECRET=change-me
