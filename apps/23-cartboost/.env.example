# --- Shopify app (partners.shopify.com -> your app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_SCOPES=read_orders,write_orders,read_products

# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/cartboost
REDIS_URL=redis://localhost:6379

# --- Token encryption ---
# 32-byte hex key for encrypting shop access tokens at rest: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# --- Session ---
AUTH_SECRET=change-me

NEXT_PUBLIC_APP_URL=http://localhost:3000
