# ------------------------------------------------------------------
# RigRent environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string (Neon; pooled for app, direct for migrations).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/rigrent?sslmode=require

# Redis connection string for BullMQ (Upstash TLS rediss:// URL).
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL. Local dev: http://localhost:3000.
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for customer quote/sign link tokens (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (Connect for deposits; Billing for RigRent's plans) ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_YARD=your-yard-price-id
STRIPE_PRICE_FLEET=your-fleet-price-id
STRIPE_PRICE_PRO=your-pro-price-id

# --- Photos + documents (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=rigrent-media

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="RigRent <orders@mail.rigrent.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and Stripe captures/releases and
# log instead (safety switch for local dev and staging).
DRY_RUN=1
