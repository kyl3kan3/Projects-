# ------------------------------------------------------------------
# RigRent environment variables
# Copy to .env.local (the Next.js app) and .env (the worker), then fill in.
# Never commit real values.
#
# Only DATABASE_URL, SESSION_SECRET and LINK_TOKEN_SECRET are needed to boot.
# Everything else degrades honestly, and the UI says which mode it is in:
#   * no Stripe key  -> deposit holds are SIMULATED, and every screen showing one
#                       says "simulated". No card is ever contacted.
#   * no R2 keys     -> condition photos and PDFs go to the local filesystem and
#                       are served by /api/files/[...key], which enforces the same
#                       ownership a presigned URL would have encoded.
#   * no Resend key  -> email is logged instead of sent.
#   * no REDIS_URL   -> /api/cron/tick does the background work instead of the
#                       BullMQ worker. Both call the same functions.
# ------------------------------------------------------------------

# --- Core ---

# Neon: use the POOLED string for the app, the DIRECT one for `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/rigrent?sslmode=require

# Optional. Set it and `npm run worker` drains BullMQ with retries and a
# dead-letter queue; leave it unset and /api/cron/tick runs the same work inline
# (the Vercel shape — see the root DEPLOYING.md).
REDIS_URL=rediss://default:password@example.upstash.io:6379

APP_URL=http://localhost:3060

# --- Auth ---

# Session cookie signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Signs the customer quote links (/q/[token]). Deliberately separate from the
# session secret: rotating a secret that travels through email must not sign every
# yard hand out of the app.
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Vercel sends this as `Authorization: Bearer …`. /api/cron/tick REFUSES to run
# when it is unset rather than defaulting to open — it can cancel and re-place a
# card authorisation on every open rental in the database.
CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional. How long one tick may run before deferring the rest (default 45000).
CRON_TICK_BUDGET_MS=

# --- Stripe ---
# Connect (Standard) carries the customer deposit holds on the OPERATOR's own
# account, so customer money never touches RigRent. Billing carries RigRent's own
# three plans on the platform account. One webhook route verifies both secrets.

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-signing-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-signing-secret
STRIPE_PRICE_YARD=your-yard-price-id
STRIPE_PRICE_FLEET=your-fleet-price-id
STRIPE_PRICE_PRO=your-pro-price-id

# --- Condition photos and documents (Cloudflare R2 over the S3 API) ---

# "local" writes photos, contracts and run sheets to the filesystem; "s3" uses the
# R2 credentials below. Defaults to s3 as soon as R2_ACCESS_KEY_ID is present.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/photos

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=rigrent-photos

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="RigRent <yard@mail.rigrent.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Safety ---

# "1" logs outbound email and simulates card holds instead of calling Stripe.
# Defaults ON whenever STRIPE_SECRET_KEY is unset, so a local run can never place
# a hold on a real customer's card.
DRY_RUN=1
