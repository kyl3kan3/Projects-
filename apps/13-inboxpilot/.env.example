# ===== Backend API (src/server) =====
DATABASE_URL=postgres://user:pass@localhost:5432/inboxpilot
# Google OAuth (console.cloud.google.com -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
DRAFT_MODEL=claude-sonnet-5
# Stripe (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Session signing
JWT_SECRET=change-me

# ===== Extension build =====
# API base URL compiled into the extension
VITE_API_URL=http://localhost:8787
