# --- Database ---
# Postgres connection string (Neon/Supabase/RDS)
DATABASE_URL=postgres://user:pass@localhost:5432/lenscrm

# --- Auth ---
# Random 32+ char string for session encryption: `openssl rand -base64 32`
AUTH_SECRET=change-me
# Google OAuth (console.cloud.google.com) for photographer sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Gallery storage (S3-compatible: AWS S3 or Cloudflare R2) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=lenscrm-galleries

# --- Email automations (resend.com/api-keys) ---
RESEND_API_KEY=
EMAIL_FROM=studio@yourdomain.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 account id. dash.cloudflare.com -> R2 -> Manage API tokens
R2_ACCOUNT_ID=your-r2-account-id

# R2 access key id
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret access key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket for gallery originals + derivatives
R2_BUCKET=lenscrm-galleries

# Public base URL for cached derivatives (optional; blank routes through the app)
R2_PUBLIC_BASE=

# Set to 1 to run the pipeline without touching R2/Stripe/Resend
DRY_RUN=0
