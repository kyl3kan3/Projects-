# ------------------------------------------------------------------
# SessionScribe environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# PHI note: every service below that touches session content must have an
# executed BAA before real client data flows (see ARCHITECTURE.md). The two
# clinical providers — Deepgram and Anthropic — are deliberately OPTIONAL:
# with no key the pipeline runs built-in fixture providers, and every
# transcript and draft they produce is labelled as a fixture in the UI, in the
# exported PDF, and in the database. A demo that looked like a real clinical
# draft would be the worst dishonesty this product could commit.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string (Neon Business plan for the BAA).
# Neon dashboard -> your project -> Connection Details.
DATABASE_URL=your-postgres-connection-string

# Public base URL of the app, no trailing slash. Local dev: http://localhost:3055
APP_URL=http://localhost:3055

# Session cookie signing key (HS256). Generate with: openssl rand -base64 32
# No fallback exists on purpose: this cookie opens clinical records.
AUTH_SECRET=generate-with-openssl-rand-base64-32

# HMAC key for signed-note content hashes (the sign & lock gate).
# Generate with: openssl rand -base64 32
# No fallback on purpose: a default would make every signature forgeable by
# anyone holding this source.
NOTE_HASH_SECRET=generate-with-openssl-rand-base64-32

# --- Background work (required in production) ---

# Shared secret for /api/cron/tick, sent as `Authorization: Bearer <secret>`.
# The route REFUSES to run when this is unset rather than running unguarded, so
# a deployment that forgets it fails loudly instead of exposing the pipeline.
# Vercel: Project Settings -> Environment Variables (vercel.json declares the
# schedule). Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Transcription (Deepgram, BAA required; optional — fixture ASR if unset) ---

# API key: Deepgram console -> API Keys. https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Drafting LLM (Anthropic, BAA + zero-retention config; optional) ---

# API key: Anthropic console -> API Keys. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for note drafting. Defaults to claude-sonnet-5.
DRAFT_MODEL=claude-sonnet-5

# --- Object storage (Cloudflare R2, S3-compatible; BAA via CF enterprise) ---
# Optional. With these unset, session audio is stored in Postgres instead and
# the Trust screen says so. All four must be present to switch to R2.

# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Stripe (SessionScribe's own billing; Stripe never sees PHI) ---
# Read only by the billing routes and the Stripe webhook; the rest of the app
# runs without them and the billing screen degrades to a plan list.

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret. Local dev:
# `stripe listen --forward-to localhost:3055/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=
STRIPE_PRICE_CASELOAD=
STRIPE_PRICE_GROUP=

# --- Email (Resend — account notices only; NO PHI in any message, ever) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=

# Default From address (verified domain).
EMAIL_FROM="SessionScribe <mail@sessionscribe.app>"

# --- Policy ---

# Default audio/transcript retention window in days for new practices. Each
# practice can change its own; the signed note is the durable record.
RETENTION_DEFAULT_DAYS=30

# Set to 1 to log outbound email instead of sending it (dev default).
DRY_RUN=1
