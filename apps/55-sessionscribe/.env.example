# ------------------------------------------------------------------
# SessionScribe environment variables
# Copy to .env.local and fill in. Never commit real values.
# PHI note: every service below that touches session content must have
# an executed BAA before real client data flows (see ARCHITECTURE.md).
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string (Neon Business plan for the BAA).
# Neon dashboard -> your project -> Connection Details.
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ (Upstash -> your database -> connect).
# Job payloads carry IDs only — PHI never enters Redis.
REDIS_URL=your-upstash-redis-connection-string

# Public base URL of the app. Local dev: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Transcription (Deepgram, BAA required) ---

# API key: Deepgram console -> API Keys. https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Drafting LLM (Anthropic, BAA + zero-retention config required) ---

# API key: Anthropic console -> API Keys. https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used for note drafting (overridable per environment).
DRAFT_MODEL=claude-sonnet-5

# --- Object storage (Cloudflare R2, S3-compatible; BAA via CF enterprise) ---

# Session audio and export PDFs. R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Stripe (SessionScribe's own billing; Stripe never sees PHI) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev:
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=your-stripe-price-id-solo
STRIPE_PRICE_CASELOAD=your-stripe-price-id-caseload
STRIPE_PRICE_GROUP=your-stripe-price-id-group

# --- Email (Resend — auth links and notifications; NO PHI in any email) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (verified domain).
EMAIL_FROM="SessionScribe <mail@sessionscribe.app>"

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider).
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets & policy ---

# HMAC secret for signed-note content hashes (the sign & lock gate).
# Generate with: openssl rand -base64 32
NOTE_HASH_SECRET=generate-with-openssl-rand-base64-32

# Default audio/transcript retention window in days for new practices
# (each practice can change its own; the signed note is the durable record).
RETENTION_DEFAULT_DAYS=30

# --- Observability (optional in dev) ---

# Sentry DSN with PII scrubbing enabled. Sentry -> Project -> Client Keys.
SENTRY_DSN=

# Set to "1" to log outbound email and skip real ASR/LLM calls (fixture
# responses) — safety switch for dev against anything resembling real data.
DRY_RUN=1
