# ------------------------------------------------------------------
# RecallDesk environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# PHI note: patient rosters are PHI — every service in the data path
# needs an executed BAA before real data flows (see ARCHITECTURE.md).
#
# Only DATABASE_URL, SESSION_SECRET and BOOKING_TOKEN_SECRET are
# required to run the app. Everything else degrades honestly: with no
# email or SMS provider the app records touches and logs what it would
# have sent; with no Stripe keys the billing screen shows the plans and
# says plainly that checkout is unconfigured.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon Business plan for the BAA; use the
# POOLED connection string (the host with "-pooler" in it).
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Local dev: http://localhost:3056.
APP_URL=http://localhost:3056
NEXT_PUBLIC_APP_URL=http://localhost:3056

# --- Secrets (required; no safe default) ---

# Signs the staff session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Signs the tokenised patient booking and unsubscribe links, which are
# bearer credentials into one patient's own record. A different secret
# from the session on purpose: a different blast radius.
# Generate with: openssl rand -base64 32
BOOKING_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Protects /api/cron/tick, which sends patient email and SMS. The route
# refuses when this is unset rather than defaulting to open. On Vercel the
# platform sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# How long one tick may spend before it stops and reports. Optional.
# TICK_BUDGET_MS=45000

# How often `npm run worker` runs a tick, if you run the long-lived worker
# shape instead of (or alongside) the cron route. Optional.
# WORKER_INTERVAL_MS=60000

# --- Email (Resend — campaign touches) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
# Leave blank to record touches without sending them.
RESEND_API_KEY=your-resend-api-key

# Svix signing secret for Resend delivery/bounce webhooks. Without it the
# webhook refuses events rather than trusting anonymous suppression requests.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Default From address (verified domain; per-practice sending domains are
# configured per location in-product).
EMAIL_FROM="RecallDesk <mail@recalldesk.app>"

# --- SMS (Twilio — Recall Engine tier; 10DLC + STOP handling mandatory) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
# The auth token also verifies inbound webhook signatures.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Default E.164 sending number (per-location numbers configured in-product).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Stripe (RecallDesk's own billing; Stripe never sees PHI) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Local dev:
# `stripe listen --forward-to localhost:3056/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products). Each is a
# per-unit monthly price; the quantity is the practice's location count.
STRIPE_PRICE_CHAIRSIDE=your-stripe-price-id-chairside
STRIPE_PRICE_RECALL_ENGINE=your-stripe-price-id-recall-engine
STRIPE_PRICE_GROUP=your-stripe-price-id-group

# --- Object storage (Cloudflare R2, S3-compatible; optional) ---

# Where uploaded PMS CSV exports go. When these are unset the CSV bytes are
# stored in Postgres instead, which is a working deployment rather than a
# broken one — the preview, commit and rollback all still re-read the file.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Policy defaults (per-practice settings override these in-product) ---

# Attribution window in days: a booking counts as recovered production only
# within this many days of a qualifying touch. Conservative by design.
ATTRIBUTION_WINDOW_DAYS=30

# Default estimated hygiene-visit value in cents ($300).
DEFAULT_VISIT_VALUE_CENTS=30000

# --- Safety switch ---

# DRY_RUN=1 records touches and logs what would have been sent, without
# sending anything. Keep it on while rehearsing a campaign against a real
# imported roster — the log lines carry ids and sizes only, never PHI.
DRY_RUN=1
