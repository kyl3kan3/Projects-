# ------------------------------------------------------------------
# RecallDesk environment variables
# Copy to .env.local and fill in. Never commit real values.
# PHI note: patient rosters are PHI — every service in the data path
# needs an executed BAA before real data flows (see ARCHITECTURE.md).
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string (Neon Business plan for the BAA).
# Neon dashboard -> your project -> Connection Details.
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ (Upstash -> your database -> connect).
# Job payloads carry IDs only — PHI never enters Redis.
REDIS_URL=your-upstash-redis-connection-string

# Public base URL of the app. Local dev: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Object storage (Cloudflare R2, S3-compatible) ---

# Uploaded PMS CSV exports and generated owner-report PDFs.
# R2 dashboard -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Email (Resend — campaign touches + staff notifications) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for Resend delivery webhooks (delivery/bounce status).
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Default From address (verified domain; per-practice sending domains
# are configured per location in-product).
EMAIL_FROM="RecallDesk <mail@recalldesk.app>"

# --- SMS (Twilio — Recall Engine tier; 10DLC + STOP handling mandatory) ---

# Account SID and Auth Token: Twilio Console home page ("Account Info").
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Default E.164 sending number (per-location numbers configured in-product).
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Stripe (RecallDesk's own billing; Stripe never sees PHI) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev:
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_CHAIRSIDE=your-stripe-price-id-chairside
STRIPE_PRICE_RECALL_ENGINE=your-stripe-price-id-recall-engine
STRIPE_PRICE_GROUP=your-stripe-price-id-group

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider for staff).
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets & policy ---

# HMAC secret for tokenized patient booking links.
# Generate with: openssl rand -base64 32
BOOKING_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Attribution window in days (a booking counts as recovered only within
# this many days of a touch; conservative by design).
ATTRIBUTION_WINDOW_DAYS=30

# Default estimated hygiene-visit value in cents (per-practice override
# in settings; used for dollar-weighting and the recovered counter).
DEFAULT_VISIT_VALUE_CENTS=30000

# --- Observability (optional in dev) ---

# Sentry DSN with PII scrubbing enabled. Sentry -> Project -> Client Keys.
SENTRY_DSN=

# Set to "1" to log outbound email/SMS instead of sending — mandatory
# safety switch for dev against imported real patient data.
DRY_RUN=1
