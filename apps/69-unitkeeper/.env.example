# ------------------------------------------------------------------
# UnitKeeper environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
#
# Only DATABASE_URL, SESSION_SECRET and APP_URL are needed to boot. Everything
# else degrades honestly: with no Stripe key rent is simulated and the UI says so;
# with no R2 credentials documents go to the local filesystem; with no Resend key
# email is logged instead of sent.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/unitkeeper?sslmode=require

# Optional. Set it and `npm run worker` runs BullMQ workers; leave it unset and
# /api/cron/tick does the same work on a schedule (the Vercel shape).
REDIS_URL=rediss://default:password@example.upstash.io:6379

APP_URL=http://localhost:3069

# --- Auth ---

# Session signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Signs the tenant links (move-in, sign, pay). Deliberately separate: rotating
# links that travel through SMS must not sign every owner out.
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Vercel sends this as `Authorization: Bearer …`. /api/cron/tick REFUSES to run
# when it is unset rather than defaulting to open — it can charge every card in
# the database and overlock every unit in the yard.
CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional. How long one tick may run before deferring the rest (default 45000).
CRON_TICK_BUDGET_MS=

# --- Stripe (Connect for rent; Billing for UnitKeeper) ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret
STRIPE_PRICE_KEEPER=your-keeper-price-id
STRIPE_PRICE_YARD=your-yard-price-id
STRIPE_PRICE_DEPOT=your-depot-price-id

# --- Documents ---

# "local" writes leases, notices, statements and lien packets to the filesystem;
# "s3" uses the R2 credentials below. Defaults to s3 once R2_ACCESS_KEY_ID is set.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/documents

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=unitkeeper-documents

# --- Email (Resend) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="UnitKeeper <office@mail.unitkeeper.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Safety ---

# "1" logs outbound email and skips real card charges. Defaults ON whenever
# STRIPE_SECRET_KEY is unset, so a local run can never charge a real tenant.
DRY_RUN=1
