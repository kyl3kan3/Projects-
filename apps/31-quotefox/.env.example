# ------------------------------------------------------------------
# QuoteFox environment variables
# Copy to .env.local — Next.js reads it automatically, and so does the
# optional worker process. Every value below is a placeholder.
# ------------------------------------------------------------------

# Postgres connection string (Neon: console.neon.tech -> Connection Details).
# Use the pooled URL for the app and the direct URL for drizzle-kit migrations.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/quotefox?sslmode=require

# Public base URL. Local dev: http://localhost:3031
APP_URL=http://localhost:3031

# Session cookie signing key. Generate one with: openssl rand -hex 32
AUTH_SECRET=generate-a-32-byte-random-hex-string

# HMAC secret signing the /p/[token] proposal links homeowners open from
# email. Falls back to AUTH_SECRET when unset. openssl rand -hex 32
PROPOSAL_TOKEN_SECRET=generate-a-32-byte-random-hex-string

# Shared secret for GET /api/cron/tick (follow-up nudges, proposal expiry,
# trial expiry). The route refuses to run when this is unset. openssl rand -hex 32
CRON_SECRET=generate-a-32-byte-random-hex-string

# --- Stripe (deposits on accepted proposals + our own plan billing) ---
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=your-stripe-secret-key
# Dashboard -> Developers -> Webhooks -> endpoint signing secret.
# Local dev: stripe listen --forward-to localhost:3031/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price ids for the three plans (Dashboard -> Product catalogue).
# Left blank, checkout creates the price inline from README's pricing table.
STRIPE_PRICE_SOLO=your-stripe-price-id-for-solo
STRIPE_PRICE_CREW=your-stripe-price-id-for-crew
STRIPE_PRICE_FLEET=your-stripe-price-id-for-fleet

# --- Media storage (walkthrough audio + job photos + proposal PDFs) ---
# Cloudflare R2: dashboard -> R2 -> Manage API tokens. Leave these unset and
# QuoteFox stores objects on the local filesystem instead — fine for local dev,
# not for a serverless deploy (see LOCAL_MEDIA_DIR below).
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=quotefox-media
# Where the filesystem driver keeps objects when R2 is not configured.
LOCAL_MEDIA_DIR=.uploads

# --- AI ---
# Whisper transcription + line-item drafting. With no key, QuoteFox drafts from
# the tech's typed notes and a sample narration, and labels the result a demo
# draft in the UI rather than pretending it transcribed anything.
OPENAI_API_KEY=your-openai-api-key
# Optional model overrides.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_DRAFT_MODEL=gpt-4o

# --- Email (proposal links, view/acceptance notices, follow-up nudges) ---
# Resend: resend.com -> API Keys. Verify a sending domain first.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=QuoteFox <quotes@yourdomain.com>

# Set to 1 to log outbound email instead of sending it. Keep it on until the
# sending domain is verified — these emails go to real homeowners.
DRY_RUN=1
