# ------------------------------------------------------------------
# QuoteFox environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# Postgres connection string (Neon: console.neon.tech -> Connection Details;
# pooled URL for the app, direct URL for drizzle-kit migrations).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/quotefox?sslmode=require

# Redis for BullMQ (draft-generation jobs). Upstash TLS rediss:// URL.
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL. Local dev: http://localhost:3000
APP_URL=http://localhost:3000

# Auth.js session encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret

# --- Stripe (deposits on accepted proposals + our own plan billing) ---
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# Dashboard -> Developers -> Webhooks -> endpoint signing secret.
# Local dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Connect OAuth client ID (contractors connect their own accounts for
# deposit collection). Dashboard -> Settings -> Connect -> Onboarding options
STRIPE_CONNECT_CLIENT_ID=your-stripe-connect-client-id

# --- Media storage (job photos + walkthrough audio) ---
# Cloudflare R2: dashboard -> R2 -> Manage API tokens
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=quotefox-media

# --- AI ---
# Walkthrough audio transcription (OpenAI Whisper). platform.openai.com
OPENAI_API_KEY=your-openai-api-key
# Line-item drafting against the price book (Claude). console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Email (proposal links, acceptance notices) ---
# Resend: resend.com -> API Keys. Verify a sending domain first.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=quotes@yourdomain.com

# --- App secrets ---
# HMAC secret signing the /p/[token] proposal links homeowners open from
# email. Generate: openssl rand -base64 32
PROPOSAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---
# Sentry -> Project -> Settings -> Client Keys (DSN). https://sentry.io
SENTRY_DSN=

# --- Worker ---
# Set to "1" to disable outbound email and skip real AI calls (canned
# drafts) -- safety switch for local dev and staging.
DRY_RUN=1
