# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# Next.js
.next/
out/
next-env.d.ts

# Build output
dist/
build/

# Environment files (keep .env.example)
.env
.env.*
!.env.example

# Testing
coverage/
.nyc_output/

# Drizzle: the migrations AND drizzle/meta are tracked on purpose. `db:migrate`
# reads drizzle/meta/_journal.json, so a fresh clone without it cannot migrate.
drizzle/meta/*.bak

# TypeScript
*.tsbuildinfo

# Local media store (the filesystem storage driver, used when R2 is unset)
.uploads/

# Local server pid from `next start & echo $! > .server.pid`
.server.pid

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel
.vercel

# Misc
*.pem
.turbo/
