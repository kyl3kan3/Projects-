# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/callcatch
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- Telephony (console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # A2P 10DLC-registered messaging service
# Public base URL Twilio webhooks hit
PUBLIC_WEBHOOK_URL=https://your-domain.com

# --- Voice AI ---
DEEPGRAM_API_KEY=               # console.deepgram.com
ANTHROPIC_API_KEY=your-anthropic-api-key
CONVERSATION_MODEL=claude-sonnet-5
TTS_API_KEY=                    # elevenlabs.io or similar

# --- Calendars ---
GOOGLE_CLIENT_ID=               # console.cloud.google.com (Calendar API)
GOOGLE_CLIENT_SECRET=
CALCOM_API_KEY=                 # cal.com settings -> developer

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Notifications ---
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
