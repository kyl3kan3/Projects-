# ------------------------------------------------------------------
# CertShield environment variables
# Copy to .env (read by the app, the worker, and db:migrate/db:seed).
# Never commit real values.
#
# Only DATABASE_URL, SESSION_SECRET and LINK_TOKEN_SECRET are required to run.
# Everything else degrades honestly and the settings screen says which way:
#   no ANTHROPIC_API_KEY  -> certificates are read by the built-in ACORD grammar
#   no R2_*               -> certificate PDFs are stored as bytes in Postgres
#   no RESEND_API_KEY     -> chases are recorded and logged, not sent
#   no STRIPE_*           -> the billing screen lists plans without a checkout
#   no REDIS_URL          -> parsing runs inline and /api/cron/tick does the rest
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/certshield?sslmode=require
APP_URL=http://localhost:3062

# Optional. Set it to run the standalone worker (`npm run worker`); leave it unset
# on Vercel, where /api/cron/tick does the same work on a schedule.
REDIS_URL=rediss://default:password@example.upstash.io:6379

# --- Auth ---

# Signs the office session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMACs the vendor upload-link tokens. A separate secret on purpose: rotating it
# invalidates every upload link without logging anybody out.
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Parsing (Claude API) ---

# Anthropic API key. https://console.anthropic.com -> API Keys.
# Unset: the deterministic ACORD reader in src/lib/acord.ts is used instead.
ANTHROPIC_API_KEY=your-anthropic-api-key

# claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5-20251001
PARSE_MODEL=claude-sonnet-5

# Per-field confidence floor, 1-100. Any field below it sends the whole
# certificate to human review instead of into compliance.
PARSE_REVIEW_THRESHOLD=80

# --- Certificates (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=certshield-certificates

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_LEDGER=your-ledger-price-id
STRIPE_PRICE_PORTFOLIO=your-portfolio-price-id
STRIPE_PRICE_ENTERPRISE=your-enterprise-price-id

# --- Email (Resend: chases + inbound certificates) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="CertShield <compliance@mail.certshield.app>"

# Bearer token the inbound-certificate webhook requires. The endpoint refuses to
# run at all when this is unset.
INBOUND_PARSE_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Bearer token for GET /api/cron/tick (Vercel Cron). The route refuses to run
# when this is unset rather than defaulting to open.
CRON_SECRET=generate-with-openssl-rand-base64-32

# How long one tick may run before it stops and lets the next one continue.
CRON_TICK_BUDGET_MS=50000

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Delivery ---

# Set to "1" to log outbound email instead of sending it. Chases are still
# recorded in the ledger, so exactly-once behaviour is identical either way.
DRY_RUN=1
