# ------------------------------------------------------------------
# CertShield environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/certshield?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth ---

# Session signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for vendor upload-link tokens (jose).
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Parsing (Claude API) ---

# Anthropic API key. https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Certificates (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=certshield-certificates

# --- Stripe ---

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_LEDGER=your-ledger-price-id
STRIPE_PRICE_PORTFOLIO=your-portfolio-price-id
STRIPE_PRICE_ENTERPRISE=your-enterprise-price-id

# --- Email (Resend: chases + inbound certificates) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="CertShield <compliance@mail.certshield.app>"
INBOUND_PARSE_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and log instead.
DRY_RUN=1
