{
  "name": "paidwell",
  "version": "0.1.0",
  "private": true,
  "description": "Accounts-receivable autopilot for agencies and service firms: escalating follow-up in the firm's voice, client payment portal, promise tracking, cash-flow forecast",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
