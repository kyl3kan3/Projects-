# ------------------------------------------------------------------
# PaidWell environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Only DATABASE_URL and AUTH_SECRET are required to boot. Everything else
# degrades honestly: with no accounting credentials the connect screen offers a
# clearly-labelled demo book, with no Resend key sends are recorded but not
# delivered, and with no Stripe key the portal says so instead of showing a Pay
# button that cannot work.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the pooled URL for the app and the direct URL for
# `npm run db:migrate`. https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL, used in portal links inside follow-up emails.
# Local dev: http://localhost:3043. Production: https://app.your-domain.com
APP_URL=http://localhost:3043

# --- App secrets ---

# HMAC secret for signing client-portal links. Generate with:
# openssl rand -base64 32   (falls back to AUTH_SECRET if unset)
PORTAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret for the daily sweep at /api/cron/tick. The route REFUSES to run
# when this is unset rather than defaulting to open — it sends email on a firm's
# behalf. Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Accounting sync (optional) ---

# QuickBooks Online app credentials. Intuit developer portal ->
# your app -> Keys & credentials. https://developer.intuit.com
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
# Webhook verifier token from the same app's Webhooks section.
QBO_WEBHOOK_VERIFIER=your-quickbooks-webhook-verifier

# Xero app credentials. Xero developer portal -> My Apps -> your app.
# https://developer.xero.com/app/manage
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_WEBHOOK_KEY=your-xero-webhook-key

# --- Stripe: portal payments via Connect, plus our own billing (optional) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price ids for the three plans. Leave blank and Checkout builds the line item
# inline from the prices in src/lib/plans.ts, which is enough to test the flow.
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_FIRM=
STRIPE_PRICE_PRACTICE=

# --- Email via Resend (optional) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Fallback From address, used until a firm verifies its own sending domain
# in-app. Firm follow-ups then send from billing@<their-domain>.
EMAIL_FROM="PaidWell <notifications@your-verified-domain>"

# Signing secret for Resend delivery and inbound-reply webhooks. The webhook
# refuses unsigned requests, so stop-on-reply needs this set.
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- Observability (optional) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Safety and tuning ---

# "1" logs outbound email instead of sending it. Leave it on until you have
# checked the ladder against your own data — this product mails your clients.
DRY_RUN=1

# How long the cron sweep may run before stopping and letting the next
# invocation continue. Defaults to 50000 (Vercel's limit is higher).
CRON_TICK_BUDGET_MS=

# Only for the optional long-lived worker (`npm run worker`), which is not
# needed on Vercel. Milliseconds between sweeps; minimum 60000.
WORKER_INTERVAL_MS=
