# ------------------------------------------------------------------
# PaidWell environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (pooled URL for the app, direct URL for drizzle-kit migrations).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.paidwell.com
APP_URL=http://localhost:3000

# --- Accounting sync ---

# QuickBooks Online app credentials. Intuit developer portal ->
# your app -> Keys & credentials. https://developer.intuit.com
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
# Webhook verifier token from the same app's Webhooks section.
QBO_WEBHOOK_VERIFIER=your-quickbooks-webhook-verifier

# Xero app credentials. Xero developer portal -> My Apps -> your app.
# https://developer.xero.com/app/manage
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_WEBHOOK_KEY=your-xero-webhook-key

# --- Stripe (portal payments via Connect + our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (Stripe Elements on the client payment portal).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (Resend) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for system emails (firm follow-ups send from
# per-firm verified domains configured in-app).
EMAIL_FROM="PaidWell <notifications@your-verified-domain>"

# Signing secret for Resend delivery/inbound webhooks.
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider).
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for signing client-portal tokens (links in follow-up emails).
# Generate with: openssl rand -base64 32
PORTAL_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and log instead (safety switch for
# local dev and staging against live firm data).
DRY_RUN=1
