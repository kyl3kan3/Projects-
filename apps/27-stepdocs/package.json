{
  "name": "stepdocs",
  "version": "0.1.0",
  "private": true,
  "description": "Record a workflow once, get a polished step-by-step guide",
  "scripts": {
    "dev": "next dev",
    "dev:extension": "vite --config extension.vite.config.ts",
    "build": "next build",
    "build:extension": "vite build --config extension.vite.config.ts",
    "start": "next start",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "stripe": "^17.5.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "tesseract.js": "^5.1.0",
    "sharp": "^0.33.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/chrome": "^0.0.290",
    "vite": "^6.0.0",
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "drizzle-kit": "^0.30.0",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0"
  }
}
