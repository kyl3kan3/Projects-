# ===== Web app / API =====
DATABASE_URL=postgres://user:pass@localhost:5432/stepdocs
AUTH_SECRET=change-me
# Screenshot storage (S3/R2), encrypted at rest
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=stepdocs-shots
# 32-byte hex for screenshot envelope encryption: `openssl rand -hex 32`
MEDIA_ENCRYPTION_KEY=
# Step-text polish (console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Billing (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Extension build =====
VITE_API_URL=http://localhost:3000
