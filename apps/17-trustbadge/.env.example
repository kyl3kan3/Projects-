# --- Database (Neon: use the POOLED connection string, the host with -pooler) ---
DATABASE_URL=postgres://user:pass@localhost:5432/trustbadge

# --- Auth ---
# Signs the session cookie. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-32-byte-random-hex-string

# --- Public URLs ---
# Where the dashboard, the hosted review form, and the widget API live.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base the embed script is served from. Point this at your CDN in
# production; defaults to NEXT_PUBLIC_APP_URL + /widget.
NEXT_PUBLIC_WIDGET_CDN_URL=http://localhost:3000/widget

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Recurring price IDs, one per paid tier (dashboard.stripe.com/products)
STRIPE_PRICE_STARTER=your-starter-price-id
STRIPE_PRICE_GROWTH=your-growth-price-id
STRIPE_PRICE_PRO=your-pro-price-id

# --- Shopify app (partners.shopify.com -> your app -> API keys) ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
# Scopes requested at install; must match the app configuration in Partners.
SHOPIFY_SCOPES=read_orders,read_fulfillments,write_script_tags

# --- Review-request email (resend.com/api-keys) ---
# Unset in development: sends are logged instead of delivered, and the request is
# left un-sent rather than recorded as if it had gone out.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=TrustBadge <reviews@your-domain.com>

# --- Cron (Vercel sends this as `Authorization: Bearer ...`) ---
# The scheduler route refuses to run when this is unset, rather than defaulting
# to an open trigger.
CRON_SECRET=your-cron-shared-secret

# --- Media: photo reviews (Cloudflare R2 or any S3-compatible bucket) ---
# Leave unset to keep uploaded photos in Postgres and serve them from
# /api/media/<id> — fine for development, not for storefront traffic.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET=trustbadge-media
# Public base URL that serves objects out of that bucket.
S3_PUBLIC_URL=https://media.your-domain.com
