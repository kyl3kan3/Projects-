# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/trustbadge

# --- Auth ---
AUTH_SECRET=change-me

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Shopify app (partners.shopify.com -> your app -> API keys) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000

# --- Review-request sending ---
RESEND_API_KEY=            # email (resend.com)
TWILIO_ACCOUNT_SID=        # SMS (twilio.com/console)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Widget CDN ---
# Public base URL the embed script is served from
NEXT_PUBLIC_WIDGET_CDN_URL=http://localhost:3000/widget

# --- Media (photo/video reviews) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=trustbadge-media

NEXT_PUBLIC_APP_URL=http://localhost:3000
