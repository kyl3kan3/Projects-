# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts

# Build output
dist/
build/
*.tsbuildinfo

# The embed bundle is generated by `npm run build:widget`, which `npm run dev` and
# `npm run build` both run first. Its measured size is a build artifact, not source.
/public/widget/

# Environment files — keep .env.example tracked
.env
.env.*
!.env.example

# Drizzle migrations ARE tracked, including meta/_journal.json: drizzle-kit needs
# it to know what has already been applied. Only local backups are ignored.
drizzle/meta/*.bak

# Logs
logs/
*.log
npm-debug.log*

# Testing / coverage
coverage/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Vercel
.vercel/

# Misc local
*.local
.cache/
.turbo/
