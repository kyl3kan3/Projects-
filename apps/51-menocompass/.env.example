# MenoCompass has NO backend — these are the only keys the finished app needs.

# RevenueCat public SDK keys (app.revenuecat.com -> Project settings -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-public-key

# EAS build/submit (expo.dev -> access tokens) — CI only, not used at runtime
EXPO_ACCESS_TOKEN=your-expo-access-token
