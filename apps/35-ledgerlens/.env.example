# ------------------------------------------------------------------
# LedgerLens environment variables
# Copy to .env.local. DATABASE_URL and AUTH_SECRET are the only values
# required to run the whole product locally; everything else degrades to a
# clearly-labelled local behaviour. Never commit real values.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details; use the *pooled* host (the one with -pooler) for the app.
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL. Local dev: http://localhost:3035.
# Production: your deployed domain, e.g. https://app.ledgerlens.app
APP_URL=http://localhost:3035

# --- Object storage (Cloudflare R2, S3-compatible) ---
#
# Set all four and originals go to R2, with the browser uploading directly.
# Leave them unset and the filesystem driver stores them under
# LOCAL_STORAGE_DIR instead — a real driver with the same keys and the same
# signed-URL discipline, which is what makes a clone with no cloud account
# fully usable.
#
# R2 dashboard -> your bucket -> Manage R2 API Tokens.
# https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# Where the filesystem driver keeps objects, relative to the app directory.
LOCAL_STORAGE_DIR=.data/objects

# --- AI extraction (Anthropic) ---
#
# With no key, extraction falls back to a deterministic reader: it parses the
# text an emailed invoice carried, and for a photo it produces a stable
# low-confidence reading that always lands in the review queue. Every document
# shows which reader produced it.
#
# API key from https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Routine extraction (cheap, fast tier).
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Re-run for documents the routine model was unsure about.
EXTRACTION_ESCALATION_MODEL=claude-sonnet-5

# --- Inbound + outbound email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for the inbound-email webhook. Resend dashboard -> Webhooks.
# The webhook REFUSES every request while this is unset — an unauthenticated
# ingest endpoint is a way to write into someone else's books.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Domain that receives forwarded documents (MX configured in Resend Inbound).
INBOUND_EMAIL_DOMAIN=in.ledgerlens.app

# From address for digests and close emails (a verified domain).
EMAIL_FROM="LedgerLens <mail@ledgerlens.app>"

# --- Stripe (LedgerLens's own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks.
# Local dev: from `stripe listen --forward-to localhost:3035/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price ids for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=your-stripe-price-id-solo
STRIPE_PRICE_OPERATOR=your-stripe-price-id-operator
STRIPE_PRICE_PRO=your-stripe-price-id-pro

# --- Signed links ---

# HMAC secret for accountant share tokens and short-lived document URLs.
# Falls back to AUTH_SECRET when unset, but keep them separate in production:
# a share link outlives a session.
# Generate with: openssl rand -base64 32
SHARE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Protects /api/cron/tick. The route REFUSES to run while this is unset rather
# than defaulting to open — the tick spends money on a model and sends mail on
# an operator's behalf. Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-with-openssl-rand-base64-32

# How long one tick may run before it stops and leaves the rest for the next
# one. Keep it well inside your host's function duration limit.
CRON_TICK_BUDGET_MS=50000

# Interval for the optional `npm run worker` loop (non-serverless hosts only).
WORKER_INTERVAL_MS=60000

# Set to "1" to log outbound email instead of sending it, and to skip Stripe
# usage reporting.
DRY_RUN=1
