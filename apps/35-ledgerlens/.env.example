# ------------------------------------------------------------------
# LedgerLens environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled string for the app, direct for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.ledgerlens.app
APP_URL=http://localhost:3000

# --- Object storage (Cloudflare R2, S3-compatible) ---

# R2 dashboard -> your bucket -> Manage R2 API Tokens.
# https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- AI extraction (Anthropic) ---

# API key from https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used for routine extraction (cheap/fast tier).
EXTRACTION_MODEL=claude-haiku-4-5

# Model used to re-run documents the routine model was unsure about.
EXTRACTION_ESCALATION_MODEL=claude-sonnet-4-6

# --- Inbound + outbound email (Resend) ---

# API key. Resend dashboard -> API Keys -> Create. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Signing secret for Resend webhooks (inbound email + delivery events).
# Resend dashboard -> Webhooks -> your endpoint.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Domain that receives forwarded documents (MX configured in Resend Inbound).
INBOUND_EMAIL_DOMAIN=in.ledgerlens.app

# Default From address for digests and close emails (verified domain).
EMAIL_FROM="LedgerLens <mail@ledgerlens.app>"

# --- Stripe (our own billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (client-side checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks.
# Local dev: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=your-stripe-price-id-solo
STRIPE_PRICE_OPERATOR=your-stripe-price-id-operator
STRIPE_PRICE_PRO=your-stripe-price-id-pro

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider). Google Cloud Console ->
# APIs & Services -> Credentials.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for accountant share-link tokens.
# Generate with: openssl rand -base64 32
SHARE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. Sentry -> Project -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and Stripe usage reporting, and to
# log extraction calls instead of billing them (safety switch for dev).
DRY_RUN=1
