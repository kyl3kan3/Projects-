    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.41.0",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
