# ------------------------------------------------------------------
# ClauseCompass environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details (pooled URL for the app, direct URL for drizzle-kit migrations).
# https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Redis connection string for BullMQ. Upstash dashboard -> your database ->
# "Redis Connect" (TLS rediss:// URL). https://console.upstash.com
REDIS_URL=your-upstash-redis-url

# Public base URL. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.clausecompass.com
APP_URL=http://localhost:3000

# --- Claude API (Anthropic) ---

# API key. Anthropic Console -> API keys. https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pinned model version for the review pipeline. Upgrades go through the
# eval suite (`npm run eval`) before this value changes.
ANTHROPIC_MODEL=your-pinned-claude-model-version

# --- Object storage (Cloudflare R2, S3-compatible) ---

# R2 dashboard -> your bucket; API tokens under "Manage R2 API Tokens".
# https://dash.cloudflare.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# --- Stripe (subscriptions + per-contract checkout) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Publishable key (checkout on the upload flow).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Webhook signing secret. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (Resend) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="ClauseCompass <notifications@your-verified-domain>"

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional sign-in provider).
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# --- App secrets ---

# HMAC secret for signing report share tokens.
# Generate with: openssl rand -base64 32
SHARE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to stub Claude calls with fixture responses (fast local dev
# without token spend; the eval suite always uses the real API).
DRY_RUN=1
