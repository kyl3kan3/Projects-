# ------------------------------------------------------------------
# ClauseCompass environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# The app runs with only the first four set: without an Anthropic key it
# extracts clauses with its built-in deterministic analyser, and every report
# says so (provenance reads "local-rules-v1" instead of a model id).
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the pooled URL for the app and the direct URL for
# `npm run db:migrate`. https://console.neon.tech
DATABASE_URL=your-postgres-connection-string

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Signs read-only report share links. Generate with: openssl rand -base64 32
SHARE_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Public base URL. Local dev: http://localhost:3046
APP_URL=http://localhost:3046

# --- Claude (optional; extraction falls back to local rules without it) ---

# API key. Anthropic Console -> API keys. https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pinned model version. Changing it means re-running `npm run eval` first.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (required to sell anything) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price ids. The per-contract price is optional (one is created inline when it is
# absent); the subscription prices are required to sell those plans.
STRIPE_PRICE_PER_CONTRACT=your-stripe-price-id-for-the-19-dollar-review
STRIPE_PRICE_FREELANCER=your-stripe-price-id-for-the-29-dollar-plan
STRIPE_PRICE_STUDIO=your-stripe-price-id-for-the-79-dollar-plan

# --- Email (optional; mail is logged when unset or when DRY_RUN=1) ---

# API key. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# From address on a domain verified in Resend -> Domains.
EMAIL_FROM="ClauseCompass <reports@your-verified-domain>"

# --- Cron ---

# Bearer token for /api/cron/tick, which advances unwatched reviews and deletes
# contracts past their retention window. The endpoint refuses to run when this
# is unset. Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Local development ---

# DRY_RUN=1 logs outbound email instead of sending it.
DRY_RUN=1

# ALLOW_DEV_CREDITS=1 puts a "simulate a $19 purchase" button on the billing
# screen so the review pipeline can be exercised with no Stripe account. It is
# ignored unless STRIPE_SECRET_KEY is absent. Never set it on a deployment that
# takes real money.
ALLOW_DEV_CREDITS=0
