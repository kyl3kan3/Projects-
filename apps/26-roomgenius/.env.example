# --- Database (Postgres with pgvector) ---
DATABASE_URL=postgres://user:pass@localhost:5432/roomgenius
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- Generation (replicate.com/account/api-tokens) ---
REPLICATE_API_TOKEN=
GENERATION_MODEL=black-forest-labs/flux-dev
CONTROLNET_MODEL=            # depth/canny conditioning pipeline slug

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Media (S3/R2 + CDN) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=roomgenius-media
CDN_BASE_URL=

# --- Affiliate feeds (apply early — approvals are slow) ---
AMAZON_ASSOCIATES_TAG=
WAYFAIR_AFFILIATE_ID=
CJ_AFFILIATE_API_KEY=        # Commission Junction developer portal

NEXT_PUBLIC_APP_URL=http://localhost:3000
