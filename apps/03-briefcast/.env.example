# Briefcast environment variables
# Copy to .env.local (Next.js app) / .env (worker) and fill in real values.
# Never commit real secrets.

# --- Core ---

# Postgres connection string. Create a project at https://neon.tech (or any Postgres)
# and copy the pooled connection string.
DATABASE_URL=postgres://user:password@host/briefcast?sslmode=require

# Redis connection string for BullMQ. Create a database at https://upstash.com
# (use the TCP/ioredis URL, not the REST URL) or run redis locally.
REDIS_URL=redis://localhost:6379

# Absolute base URL of the app. Local dev: http://localhost:3000.
# Used for OAuth redirect URIs and links in Slack/email.
APP_URL=http://localhost:3000

# Secret for session/JWT signing (Auth.js AUTH_SECRET). Generate with:
# openssl rand -base64 32
AUTH_SECRET=

# --- Billing (Stripe) ---

# From https://dashboard.stripe.com/apikeys (use test keys in dev).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the webhook endpoint config at https://dashboard.stripe.com/webhooks
# (or `stripe listen --print-secret` for local dev).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Meeting bots (Recall.ai) ---

# From the Recall.ai dashboard: https://www.recall.ai (API keys page).
# Note the region-specific API host in their docs.
RECALL_API_KEY=
# Shared secret for verifying Recall webhook signatures (set when creating
# the webhook endpoint in the Recall dashboard).
RECALL_WEBHOOK_SECRET=

# --- Transcription ---

# From https://console.deepgram.com (API Keys).
DEEPGRAM_API_KEY=

# --- Extraction (Claude) ---

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Calendar OAuth ---

# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (web app); enable Calendar API; add
# {APP_URL}/api/auth/callback/google to redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center: https://entra.microsoft.com (App registrations).
# Add Calendars.Read delegated scope; redirect URI {APP_URL}/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- CRM OAuth apps ---

# HubSpot developer account: https://developers.hubspot.com -> create app.
# Scopes: crm.objects.contacts/deals read+write, crm.schemas read, sales-email-read as needed.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Salesforce: create a Connected App in Setup -> App Manager (OAuth enabled,
# scopes: api, refresh_token). Consumer key/secret below.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Pipedrive: https://developers.pipedrive.com -> Marketplace Manager -> create app.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# --- Slack ---

# https://api.slack.com/apps -> create app. Basic Information page has all three.
# Bot scopes: chat:write, im:write, users:read.email, channels:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Email ---

# From https://resend.com (API Keys). Verify a sending domain first.
RESEND_API_KEY=
