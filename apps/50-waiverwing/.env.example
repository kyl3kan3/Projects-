# ------------------------------------------------------------------
# WaiverWing environment variables
# Copy to .env.local and fill in. Never commit real values.
# (No worker process at MVP -- Vercel Cron covers scheduled jobs;
# see ARCHITECTURE.md.)
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). Enable the pg_trgm extension for participant search.
# https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/waiverwing?sslmode=require

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.waiverwing.com
# (QR codes embed this URL -- changing it in production reprints posters.)
APP_URL=http://localhost:3000

# --- File storage (AWS S3) ---

# IAM access key pair scoped to the bucket only (least privilege).
# AWS Console -> IAM -> Users -> Security credentials.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Bucket for signed-waiver PDFs and drawn-signature assets (SSE enabled).
S3_BUCKET=waiverwing-archive-dev

# --- Stripe ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_COUNTER=price_xxx
STRIPE_PRICE_FRONT_DESK=price_xxx
STRIPE_PRICE_OPERATOR=price_xxx

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for receipts and digests (domain verified in
# Resend -> Domains).
EMAIL_FROM="WaiverWing <waivers@mail.waiverwing.com>"

# --- Auth (Auth.js / NextAuth v5) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional staff sign-in). Google Cloud Console ->
# APIs & Services -> Credentials.
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx

# --- App secrets ---

# HMAC secret for signing QR/sign-link tokens and kiosk session tokens.
# Generate with: openssl rand -base64 32
SIGN_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret protecting the Vercel Cron endpoints (expiry roll,
# daily digest). Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Safety ---

# Set to "1" to disable outbound email (receipts, digests) and log
# instead -- safety switch for local dev and staging.
DRY_RUN=1
