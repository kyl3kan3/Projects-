# ------------------------------------------------------------------
# WaiverWing environment variables
# Copy to .env.local and fill in. Never commit real values.
# (No worker process at MVP -- Vercel Cron covers scheduled jobs;
# see ARCHITECTURE.md.)
#
# Only DATABASE_URL and AUTH_SECRET are required to run the product.
# Everything else degrades honestly: no Stripe means the billing screen
# says so, no S3 means PDFs render per request instead of being cached,
# no Resend (or DRY_RUN=1) means emails are logged instead of sent.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Get from Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). The first migration enables pg_trgm, which the participant
# search depends on. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/waiverwing?sslmode=require

# Session signing secret for the staff JWT cookie and the kiosk cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL of the app. Local dev: http://localhost:3050.
# Production: your deployed domain, e.g. https://app.waiverwing.com
# (QR posters embed this URL -- changing it in production means reprinting.)
APP_URL=http://localhost:3050

# --- App secrets ---

# HMAC secret for emailed sign links and re-sign links. Kept separate from
# AUTH_SECRET so rotating sign links does not sign every member of staff
# out; falls back to AUTH_SECRET when unset.
# Generate with: openssl rand -base64 32
SIGN_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# Shared secret protecting the Vercel Cron endpoint (expiry roll + daily
# digest). The route refuses to run when this is unset rather than
# defaulting to open. Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- File storage (optional: AWS S3 for cached PDFs) ---
#
# When unset, signed-waiver PDFs are rendered on each request. Nothing is
# lost -- the record lives in Postgres and the PDF is only a view of it.

# IAM access key pair scoped to the bucket only (least privilege).
# AWS Console -> IAM -> Users -> Security credentials.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Bucket for cached signed-waiver PDFs. Uploads are written with SSE.
S3_BUCKET=waiverwing-archive-dev

# --- Stripe (optional: billing) ---

# Secret API key. Stripe Dashboard -> Developers -> API keys.
# Use sk_test_... in development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret. Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint. Local dev: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Monthly price IDs for the three plans (Stripe Dashboard -> Products).
# The annual price is looked up as "<monthly id>_annual", so name the
# annual prices to match.
STRIPE_PRICE_COUNTER=price_xxx
STRIPE_PRICE_FRONT_DESK=price_xxx
STRIPE_PRICE_OPERATOR=price_xxx

# --- Email (optional: Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address for receipts and digests (domain verified in
# Resend -> Domains).
EMAIL_FROM="WaiverWing <waivers@mail.waiverwing.com>"

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Safety ---

# Set to "1" to disable outbound email (receipts, digests) and log
# instead -- safety switch for local dev and staging.
DRY_RUN=1
