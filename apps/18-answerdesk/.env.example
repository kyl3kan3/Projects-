# --- Database (Postgres with pgvector extension enabled) ---
DATABASE_URL=postgres://user:pass@localhost:5432/answerdesk
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- LLM + embeddings (console.anthropic.com / openai platform for embeddings) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=            # used only for text-embedding-3-small embeddings
ANSWER_MODEL=claude-sonnet-5

# --- Crawler worker ---
# Max pages per crawl per site
CRAWL_PAGE_LIMIT=500
CRAWL_USER_AGENT=AnswerDeskBot/1.0

# --- Handoff channels ---
RESEND_API_KEY=            # email handoff (resend.com)
SLACK_CLIENT_ID=           # Slack handoff app (api.slack.com/apps)
SLACK_CLIENT_SECRET=

# --- Widget ---
NEXT_PUBLIC_WIDGET_CDN_URL=http://localhost:3000/widget

NEXT_PUBLIC_APP_URL=http://localhost:3000
