{
  "name": "schemasentry",
  "version": "0.1.0",
  "private": true,
  "description": "API breaking-change watchdog — diff OpenAPI specs between deploys, gate CI, alert Slack, generate contract tests, publish consumer changelogs",
  "bin": {
    "schemasentry": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api": "tsx src/api/index.ts",
    "worker": "tsx src/api/worker.ts",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cors": "^10.0.0",
    "@octokit/app": "^15.1.0",
    "@slack/web-api": "^7.8.0",
    "bullmq": "^5.44.0",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "openapi-types": "^12.1.3",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
