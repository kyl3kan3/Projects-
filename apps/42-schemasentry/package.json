{
  "name": "schemasentry",
  "version": "0.1.0",
  "private": true,
  "description": "API breaking-change watchdog \u2014 diff OpenAPI specs between deploys, gate CI, alert Slack, generate contract tests, publish consumer changelogs",
  "bin": {
    "schemasentry": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api": "tsx src/api/index.ts",
    "cli": "tsx src/cli/index.ts",
    "lint": "node tools/craft-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.1.0",
    "jose": "^6.0.0",
    "next": "^15.3.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.30.0",
    "playwright": "^1.52.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
