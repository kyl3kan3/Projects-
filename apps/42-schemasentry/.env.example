# ------------------------------------------------------------------
# SchemaSentry environment variables
#
# Copy to `.env.local` (the Next.js dashboard reads it) or `.env` (the
# standalone Fastify API reads it). Never commit real values.
#
# Only the two under "Required" are needed to run the product. Everything
# else turns a feature on; the app says on screen what is switched off.
# ------------------------------------------------------------------

# --- Required ---

# Postgres connection string. Use the *pooled* endpoint on Neon (the host with
# `-pooler` in it). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/schemasentry?sslmode=require

# Session cookie + API token signing secret. Generate with:
#   openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# --- Public URLs ---

# Where the dashboard is served. Used in Slack links, changelog URLs and the
# metadataBase for OG tags. Local dev default shown.
APP_URL=http://localhost:3042

# Where the CLI and CI point. Same origin as the dashboard on Vercel; set this
# only if you run the standalone Fastify API on its own host.
API_URL=http://localhost:3042

# Port for the standalone Fastify API (`npm run api`). Ignored by Next.js.
API_PORT=8787

# --- Slack alerts (optional) ---

# An incoming-webhook URL, used as the organization default when an API has no
# webhook of its own. Create one at api.slack.com/apps -> Incoming Webhooks.
# Breaking and risky verdicts post here; compatible deploys stay silent.
SLACK_WEBHOOK_URL=

# --- GitHub check runs and PR comments (optional) ---

# A token with `pull-requests: write` and `checks: write` on the repositories
# you gate. Without it, `check` still returns the verdict and the CLI still
# exits non-zero — only the check run and the PR comment are skipped.
GITHUB_TOKEN=

# Shared secret, if you point a GitHub webhook at this deployment.
GITHUB_WEBHOOK_SECRET=

# --- Billing (optional; the plan limits apply either way) ---

# Stripe Dashboard -> Developers -> API keys (sk_test_... in development).
STRIPE_SECRET_KEY=your-stripe-secret-key
# Webhooks -> your endpoint -> Signing secret, or `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Price IDs from Stripe Dashboard -> Products. A plan with no price ID here is
# shown on the pricing table but cannot be bought.
STRIPE_PRICE_SOLO_MONTHLY=price_replace_with_your_solo_price_id
STRIPE_PRICE_TEAM_MONTHLY=price_replace_with_your_team_price_id
STRIPE_PRICE_PLATFORM_MONTHLY=price_replace_with_your_platform_price_id

# --- Changelog email (optional) ---

# https://resend.com/api-keys — without it, a subscription is still recorded and
# RSS still works, and the subscribe form says email is unavailable rather than
# pretending a message went out.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="SchemaSentry <notify@mail.schemasentry.dev>"

# --- Scheduled work ---

# Protects /api/cron/tick, which drains the notification queue. On Vercel this
# is sent automatically as `Authorization: Bearer $CRON_SECRET`. The route
# REFUSES to run when this is unset rather than defaulting to open.
#   openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# How long one tick may spend delivering before it stops and leaves the rest for
# the next one. Optional; defaults to 45000.
CRON_TICK_BUDGET_MS=45000
