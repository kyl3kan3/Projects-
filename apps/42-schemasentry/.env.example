# ------------------------------------------------------------------
# SchemaSentry environment variables
# Copy to .env (API + worker) and .env.local (Next.js dashboard).
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details. https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/schemasentry?sslmode=require

# Redis connection string for BullMQ (TLS rediss:// URL).
# https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URLs. Local dev defaults shown.
APP_URL=http://localhost:3000
API_URL=http://localhost:8787

# --- Spec storage (Cloudflare R2, S3-compatible) ---

# R2 dashboard -> Manage R2 API Tokens. https://dash.cloudflare.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=schemasentry-specs

# --- GitHub App (check runs + PR comments) ---

# github.com -> Settings -> Developer settings -> GitHub Apps.
GITHUB_APP_ID=123456
# Private key PEM contents (or a file path in dev). Same App settings page.
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-pem
# Webhook secret configured on the App.
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
# OAuth credentials for dashboard sign-in (same App).
GITHUB_CLIENT_ID=Iv1.xxx
GITHUB_CLIENT_SECRET=xxx

# --- Slack app (alerts) ---

# api.slack.com/apps -> your app -> OAuth & Permissions (bot token after
# workspace install flow) and Basic Information (signing secret).
SLACK_CLIENT_ID=xxx
SLACK_CLIENT_SECRET=xxx
SLACK_SIGNING_SECRET=xxx

# --- Billing (Stripe) ---

# Stripe Dashboard -> Developers -> API keys (sk_test_... in dev).
STRIPE_SECRET_KEY=your-stripe-secret-key
# Webhooks -> your endpoint -> Signing secret (or `stripe listen`).
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Price IDs from Stripe Dashboard -> Products.
STRIPE_PRICE_SOLO_MONTHLY=price_xxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_PLATFORM_MONTHLY=price_xxx

# --- Auth / tokens ---

# Session + API-token signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# --- Email (Resend: changelog subscriptions, magic links) ---

# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="SchemaSentry <notify@mail.schemasentry.dev>"

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=
