# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/rankradar
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me
GOOGLE_CLIENT_ID=          # also used for GSC connect (console.cloud.google.com)
GOOGLE_CLIENT_SECRET=

# --- SERP data (app.dataforseo.com -> API access) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Briefs (console.anthropic.com) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
BRIEF_MODEL=claude-sonnet-5

# --- Billing (dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=alerts@rankradar.app

NEXT_PUBLIC_APP_URL=http://localhost:3000
