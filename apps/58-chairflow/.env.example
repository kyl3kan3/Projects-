# ------------------------------------------------------------------
# ChairFlow environment variables
#
# Copy to .env.local (the Next.js app reads it) and fill in. `npm run worker`
# and `npm run db:seed` read the same file. Never commit real values.
#
# Only DATABASE_URL, AUTH_SECRET and LINK_TOKEN_SECRET are required to run the
# app. Everything else degrades honestly rather than breaking:
#
#   - with no Stripe key, deposits and fees are *recorded* and every screen
#     that shows one says "recorded, not charged";
#   - with no Resend or Twilio key, comms are recorded with their full text and
#     the client's message history says "recorded, not sent";
#   - with no CRON_SECRET, /api/cron/tick refuses every request rather than
#     defaulting to open.
# ------------------------------------------------------------------

# --- Core (required) ---

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details. Use the POOLED URL (the host with "-pooler" in it) for the app and
# the direct one for drizzle-kit migrations. https://console.neon.tech
DATABASE_URL=your-neon-postgres-connection-string

# Public base URL of the app. Local dev: http://localhost:3058.
# Production: your deployed domain, e.g. https://app.chairflow.io
APP_URL=http://localhost:3058
NEXT_PUBLIC_APP_URL=http://localhost:3058

# --- Secrets (required; no safe default) ---

# Signs the stylist/owner session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Signs the client-facing links — manage-appointment, nudge-booking,
# waitlist-claim. Each is a bearer credential into one appointment, so this is a
# different secret from the session on purpose: a different blast radius.
# Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Scheduled work ---

# Protects /api/cron/tick, which sends client email and SMS. The route refuses
# every request when this is unset rather than defaulting to open. On Vercel the
# platform sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# How long one tick may spend before it stops and reports. Optional.
# TICK_BUDGET_MS=45000

# How often `npm run worker` runs a tick, if you run the long-lived worker shape
# instead of (or alongside) the cron route. Optional.
# WORKER_INTERVAL_MS=60000

# --- Stripe (Connect Express for client money; Billing for ours) ---

# Platform secret API key. Stripe Dashboard -> Developers -> API keys. Use the
# test-mode key in development. Leave blank to record deposits and fees without
# charging anything.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secrets: one endpoint for platform (Billing) events, one for
# Connect (connected-account) events. Both are verified by
# /api/webhooks/stripe, platform first. Local dev:
# `stripe listen --forward-to localhost:3058/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products). Each is a
# monthly recurring price.
STRIPE_PRICE_CHAIR=your-stripe-price-id-chair
STRIPE_PRICE_BOOK=your-stripe-price-id-book
STRIPE_PRICE_SHOP=your-stripe-price-id-shop

# --- SMS (Twilio; 10DLC registration required before launch) ---

# Account SID and Auth Token: Twilio Console home ("Account Info"). The auth
# token also verifies inbound webhook signatures, including STOP.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Sending number in E.164 format.
TWILIO_FROM_NUMBER=your-twilio-phone-number

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="ChairFlow <bookings@mail.chairflow.io>"

# --- Safety switch ---

# DRY_RUN=1 records every comm and every charge without calling any provider,
# and marks the rows so no screen claims money moved. Keep it on while
# rehearsing against a real book.
DRY_RUN=1
