# ------------------------------------------------------------------
# ChairFlow environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> your project ->
# Connection Details (pooled URL for the app, direct for drizzle-kit
# migrations). https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/chairflow?sslmode=require

# Redis connection string for BullMQ. Upstash dashboard -> your database
# -> "Redis Connect" (use the TLS rediss:// URL). https://console.upstash.com
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL of the app. Local dev: http://localhost:3000.
# Production: your deployed domain, e.g. https://app.chairflow.io
APP_URL=http://localhost:3000

# --- Auth (Auth.js / NextAuth v5; stylists and shop owners only —
# clients never have accounts) ---

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# HMAC secret for signing manage-appointment, nudge-booking, and
# waitlist-claim tokens (jose). Generate with: openssl rand -base64 32
LINK_TOKEN_SECRET=generate-with-openssl-rand-base64-32

# --- Stripe (Connect Express for stylist money; Billing for ours) ---

# Platform secret API key. Stripe Dashboard -> Developers -> API keys.
# Use the test-mode key in development.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secrets: one endpoint for platform (Billing) events,
# one for Connect (connected-account) events. Local dev: `stripe listen`.
STRIPE_WEBHOOK_SECRET=your-stripe-platform-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_CHAIR=your-chair-price-id
STRIPE_PRICE_BOOK=your-book-price-id
STRIPE_PRICE_SHOP=your-shop-price-id

# --- SMS (Twilio) ---

# Account credentials. Twilio Console -> Account Info.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Sending number in E.164 format (10DLC-registered before launch).
TWILIO_FROM_NUMBER=+15555550100

# --- Email (Resend) ---

# API key. Resend dashboard -> API Keys. https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Default From address (domain verified in Resend -> Domains).
EMAIL_FROM="ChairFlow <bookings@mail.chairflow.io>"

# --- Google Calendar sync (Book tier; optional in dev) ---

# OAuth client for calendar busy-block sync. Google Cloud Console ->
# APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Observability (optional in dev) ---

# Sentry DSN. https://sentry.io
SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound SMS/email and Stripe charges and log
# instead (safety switch for local dev and staging).
DRY_RUN=1
