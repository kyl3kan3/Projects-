# --- Mobile app (Expo) ---
# RevenueCat public SDK keys (app.revenuecat.com -> your project -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Optional premium sync backend (Supabase project settings -> API) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Observability ---
# Sentry DSN (sentry.io -> project -> Client Keys)
EXPO_PUBLIC_SENTRY_DSN=
# PostHog project API key (posthog.com -> project settings)
EXPO_PUBLIC_POSTHOG_KEY=
