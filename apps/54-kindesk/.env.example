# KinDesk env contract — every key the FINISHED app needs. Placeholders only; never commit real values.
# The app is local-first; the only backend is the thin end-to-end-encrypted sync relay (see ARCHITECTURE.md).

# --- RevenueCat (purchases / family-plan entitlement) ---
# Obtain: app.revenuecat.com -> your project -> Project settings -> API keys (use the PUBLIC SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-public-key

# --- Sync relay (the only server; stores ciphertext only) ---
# Obtain: deploy relay/ (Cloudflare Worker + D1 + R2) with `wrangler deploy`, then use its workers.dev
# or custom-domain URL. The app works fully offline without it; sharing/sync requires it.
EXPO_PUBLIC_SYNC_RELAY_URL=https://relay.example.workers.dev

# --- Relay deployment (CI / wrangler only — never shipped in the app bundle) ---
# Obtain: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token (Workers + D1 + R2 edit scopes)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Shared secret the relay uses to verify RevenueCat webhook calls (you invent this; set the same
# value in app.revenuecat.com -> Integrations -> Webhooks -> Authorization header)
RELAY_REVENUECAT_WEBHOOK_SECRET=your-random-webhook-secret

# --- EAS build/submit (expo.dev -> Account settings -> Access tokens) — CI only, not used at runtime ---
EXPO_ACCESS_TOKEN=your-expo-access-token
