# ------------------------------------------------------------------
# NetNest — Expo app environment (EXPO_PUBLIC_* only; secrets live in
# server/.env). Copy to .env and fill in. Never commit real values.
# ------------------------------------------------------------------

# Base URL of the NetNest server (server/ folder). Local dev with a
# device on the same network: use your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat PUBLIC SDK keys (Project -> API keys). Public keys only —
# the secret key never ships in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-public-key

# Plaid environment the app's Link flow targets (sandbox | production).
EXPO_PUBLIC_PLAID_ENV=sandbox
