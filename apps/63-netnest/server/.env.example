# ------------------------------------------------------------------
# NetNest server environment variables (server/ folder).
# Copy to .env.local (Next.js) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/netnest?sslmode=require
REDIS_URL=rediss://default:password@example.upstash.io:6379
APP_URL=http://localhost:3000

# --- Auth (magic links) ---

# Session/refresh token signing secret. openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# --- Plaid (balances/investments/liabilities scopes ONLY) ---

# Dashboard -> Team Settings -> Keys. Use sandbox in development.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Webhook verification: Plaid signs webhooks with a JWT you verify via
# their /webhook_verification_key/get endpoint — no static secret here.

# AES-256-GCM key for encrypting Plaid access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# --- RevenueCat (entitlement mirror) ---

# Webhook auth header value you configure in RC -> Integrations.
REVENUECAT_WEBHOOK_AUTH=generate-with-openssl-rand-base64-32

# --- Email (Resend: magic links + close reminders) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="NetNest <hello@mail.netnest.app>"

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# "1" short-circuits Plaid calls (fixture data) and email.
DRY_RUN=1
