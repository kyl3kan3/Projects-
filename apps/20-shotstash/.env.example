# ShotStash is local-first: the app itself needs NO env vars at runtime.
# These are for the build/release pipeline and optional Pro services.

# --- License sales (polar.sh dashboard -> settings -> API) ---
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID_LICENSE=
POLAR_PRODUCT_ID_PRO=

# --- Pro sync backend (S3/R2 for E2EE blobs) ---
SYNC_S3_ENDPOINT=
SYNC_S3_ACCESS_KEY_ID=
SYNC_S3_SECRET_ACCESS_KEY=
SYNC_S3_BUCKET=shotstash-sync

# --- Release signing ---
APPLE_SIGNING_IDENTITY=       # Developer ID Application cert name
APPLE_NOTARY_KEY_ID=          # App Store Connect API key for notarytool
WINDOWS_CERT_THUMBPRINT=      # EV/OV code-signing cert
TAURI_SIGNING_PRIVATE_KEY=    # updater artifact signing (tauri signer generate)
