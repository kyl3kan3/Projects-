# ------------------------------------------------------------------
# DispatchDeck environment variables
# Copy to .env.local (Next.js app) and .env (worker) and fill in.
# Never commit real values.
# ------------------------------------------------------------------

# --- Core ---

# Postgres connection string. Neon dashboard -> Connection Details
# (pooled URL for the app, direct for drizzle-kit migrations).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dispatchdeck?sslmode=require

# Redis connection string for BullMQ (Upstash TLS rediss:// URL).
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Public base URL. Local dev: http://localhost:3000.
APP_URL=http://localhost:3000

# --- Auth (scrypt + jose session cookies) ---

# Session signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# --- Rate-con parsing (Claude API) ---

# Anthropic API key. https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Documents (Cloudflare R2, S3-compatible) ---

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=dispatchdeck-documents

# --- Stripe (DispatchDeck's own billing) ---

# Secret API key (test mode in development).
STRIPE_SECRET_KEY=your-stripe-secret-key

# Webhook signing secret (local dev: from `stripe listen`).
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Price IDs for the three plans (Stripe Dashboard -> Products).
STRIPE_PRICE_SOLO=your-solo-price-id
STRIPE_PRICE_TEAM=your-team-price-id
STRIPE_PRICE_FLEET=your-fleet-price-id

# --- Email (Resend: outbound packets + inbound parse address) ---

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="DispatchDeck <office@mail.dispatchdeck.app>"

# Shared secret Resend inbound webhook must present (query param) so
# only Resend can post MIME to /api/inbound/rate-con.
INBOUND_PARSE_SECRET=generate-with-openssl-rand-base64-32

# --- Observability (optional in dev) ---

SENTRY_DSN=

# --- Worker ---

# Set to "1" to disable outbound email and Stripe charges and log
# instead (safety switch for local dev and staging).
DRY_RUN=1
